---
import Base from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import RoleGate from '../../components/RoleGate.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import { p } from '../../lib/url';
import { demoClass, students, assignments, LESSON_1, STATUS_LABEL } from '../../data/mock';
import { DOT_CLASS } from '../../lib/status';
import { PORTIONS, type PortionKey } from '../../lib/lessons';

const done = (k: PortionKey) => students.filter((s) => s[k] === 'done').length;
const pct = (n: number) => Math.round((n / students.length) * 100);
---
<Base title="Teacher dashboard" noindex>
  <RoleGate role="teacher" />
  <PageHeader compact title={demoClass.name}>
    <p class="meta mt-3">{demoClass.school} · {demoClass.teacher} · {students.length} students</p>
    <div slot="aside" class="flex flex-col items-start gap-2 lg:items-end">
      <button type="button" class="btn btn-primary" aria-disabled="true" aria-describedby="assign-off">Assign a lesson</button>
      <p id="assign-off" class="meta">Switched off in this demo</p>
    </div>
  </PageHeader>
  <DemoBanner role="teacher" />

  <section class="section grid gap-x-14 gap-y-12 pt-12! lg:grid-cols-[1.7fr_1fr] lg:items-start">
    <div>
      <SectionLabel>Roster</SectionLabel>
      <p class="meta mt-5">{LESSON_1.title}. Each student’s progress through its three parts.</p>
      <p class="meta mt-2 flex flex-wrap gap-x-5 gap-y-1" aria-hidden="true">
        {(['done', 'in-progress', 'not-started'] as const).map((k) => (
          <span class="inline-flex items-center gap-2"><span class:list={['dot', DOT_CLASS[k]]}></span>{STATUS_LABEL[k]}</span>
        ))}
      </p>
      <div class="table-scroll mt-4">
        <table class="result-table result-table-compact">
          <thead>
            <tr>
              <th scope="col">Student</th>
              {PORTIONS.map((pt) => <th scope="col">{pt.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {students.map((s) => (
              <tr>
                <th scope="row">{s.name}</th>
                {PORTIONS.map((pt) => (
                  <td class:list={[s[pt.key] === 'done' && 'result', s[pt.key] === 'not-started' && 'text-rule']}>
                    <span class="inline-flex items-center gap-2"><span class:list={['dot', DOT_CLASS[s[pt.key]]]} aria-hidden="true"></span><span class="sr-only sm:not-sr-only">{STATUS_LABEL[s[pt.key]]}</span></span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <aside class="grid gap-10">
      <div>
        <SectionLabel class="section-label-sm">Assigned</SectionLabel>
        <ul class="mt-1">
          {assignments.map((a) => (
            <li class="border-b border-edge py-4">
              <div class="flex items-baseline justify-between gap-4">
                <a class="font-semibold text-navy hover:underline" href={p(`${LESSON_1.path}${a.portion}/`)}>{a.title}</a>
                <span class="meta whitespace-nowrap">Due {a.due}</span>
              </div>
              <div class="mt-3 flex items-center gap-3">
                <span class="meter" role="img" aria-label={`${pct(done(a.portion))} percent done`}><span style={`width:${pct(done(a.portion))}%`}></span></span>
                <span class="meta whitespace-nowrap tabular-nums">{done(a.portion)} of {students.length} done</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="panel">
        <h2 class="text-lg">Teacher notes</h2>
        <p class="mt-2 text-[0.9375rem] text-rule">Each part of a lesson shows its teacher notes while you are here as a teacher.</p>
        <a class="btn btn-secondary mt-5" href={p(LESSON_1.path)}>Open Lesson 1</a>
      </div>
    </aside>
  </section>
</Base>
