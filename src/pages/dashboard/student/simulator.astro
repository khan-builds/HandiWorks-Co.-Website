---
/** The simulator: six guided steps for Lesson 1, from a see-saw to the finger of the hand.
    Reached from the student dashboard. A demo, and the page says so. The steps are in
    src/scripts/sim/steps.ts and finger.ts; what the page does is in src/scripts/sim/sim.ts. */
import Base from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import RoleGate from '../../../components/RoleGate.astro';
import { p, asset } from '../../../lib/url';
import { STEPS } from '../../../scripts/sim/steps';
import { FINGER_TITLE } from '../../../scripts/sim/finger';

const titles = [...STEPS.map((step) => step.title), FINGER_TITLE];
---
<Base title="Simulator" description="Six guided steps from a see-saw to the finger of the HelpingHand hand. A demo." noindex>
  <RoleGate role="student" />
  <PageHeader compact title="Simulator">
    <nav slot="crumbs" class="crumbs" aria-label="Breadcrumb">
      <a href={p('/dashboard/student/')}>Student dashboard</a> <span class="mx-1" aria-hidden="true">/</span> Simulator
    </nav>
    <p class="meta mt-4 flex max-w-3xl flex-wrap items-baseline gap-x-3 gap-y-2">
      <span class="badge badge-demo">Demo</span>
      <span>A rough first version. Six steps for Lesson 1, from a see-saw to the finger of the hand. Nothing here is saved.</span>
    </p>
  </PageHeader>

  <section class="section sim pt-10!" data-sim data-hand-data={asset('/hand-data.js')}>
    <nav class="sim-steps" aria-label="Steps">
      <ol>
        {titles.map((title, i) => (
          <li><button type="button" data-step={i} data-name={title} title={title}><span>{i + 1}</span></button></li>
        ))}
      </ol>
      <p class="meta" data-total>0 of 6 answered</p>
    </nav>

    <div class="sim-grid">
      <div class="sim-stage-col">
        <div class="sim-stage">
          <svg data-stage role="img" aria-label="" preserveAspectRatio="xMidYMid meet"></svg>
        </div>
        <div class="sim-stage sim-three" data-three hidden>
          <canvas data-finger role="img" aria-label="The same finger from the CAD, moving with the drawing above"></canvas>
          <p class="sim-three-note" data-three-note>Loading the finger…</p>
        </div>
        <div class="sim-move">
          <button class="btn btn-secondary" type="button" data-play aria-pressed="false">Play</button>
          <label for="sim-input" data-input-label>Move it</label>
          <input id="sim-input" type="range" data-input />
        </div>
        <p class="meta sim-key"><span class="sim-key-fixed" aria-hidden="true"></span> a pin held by the frame <span class="sim-key-joint" aria-hidden="true"></span> a pin that joins two bars <span class="sim-key-handle" aria-hidden="true"></span> drag here</p>
      </div>

      <div class="sim-text">
        <p class="meta" data-count>Step 1 of 6</p>
        <h2 class="sim-title" data-title></h2>
        <p class="mt-4" data-waiting hidden>Loading the finger from the CAD…</p>
        <div data-live>
          <div class="sim-body" data-body></div>

          <div class="sim-setting" data-setting>
            <label for="sim-setting" id="sim-setting-label" data-setting-label></label>
            <input id="sim-setting" type="range" data-setting-range />
            <div class="sim-choices" role="group" aria-labelledby="sim-setting-label" data-setting-choices hidden></div>
          </div>
          <p class="sim-says" data-says aria-live="polite" hidden></p>

          <p class="note mt-6"><strong>What to notice.</strong> <span data-notice></span></p>

          <div class="sim-question">
            <h3 data-ask></h3>
            <div class="sim-answers" data-answers></div>
            <p class="sim-verdict" data-verdict aria-live="polite"></p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <button class="btn btn-secondary" type="button" data-back>Back</button>
          <button class="btn btn-primary" type="button" data-next>Next step</button>
        </div>
      </div>
    </div>
    <noscript><p class="note mt-8">The simulator needs JavaScript.</p></noscript>
  </section>
</Base>

<script>
  import '../../../scripts/sim/sim.ts';
</script>

<style is:global>
  /* The simulator. Class names start with "sim" so nothing here reaches another page. */
  .sim-steps { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .sim-steps ol { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sim-steps button { position: relative; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--color-navy); font-size: 1rem; font-weight: 600; color: var(--color-navy); cursor: pointer; transition: background-color 160ms, color 160ms; }
  .sim-steps button:hover { background: var(--navy-tint); }
  .sim-steps button[aria-current="step"] { background: var(--color-navy); color: var(--color-white); }
  /* An answered step carries a small lime corner. */
  .sim-steps button.is-done::after { content: ''; position: absolute; top: -1px; right: -1px; width: 0.75rem; height: 0.75rem; background: var(--color-lime); border: 1px solid var(--color-navy); }

  .sim-grid { display: grid; gap: 2.5rem 3.5rem; margin-top: 1.75rem; }
  .sim-grid > * { min-width: 0; }
  @media (min-width: 64rem) {
    .sim-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; }
    .sim-stage-col { position: sticky; top: calc(var(--nav-height) + 1.25rem); }
  }

  .sim-stage { position: relative; background: var(--color-panel); border: 1px solid var(--color-edge); }
  .sim-stage svg { display: block; width: 100%; aspect-ratio: 3 / 2; cursor: grab; touch-action: none; user-select: none; }
  .sim-stage svg.is-held { cursor: grabbing; }
  .sim-three { margin-top: 0.75rem; }
  .sim-three canvas { display: block; width: 100%; aspect-ratio: 2 / 1; }
  .sim-three-note { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; text-align: center; font-size: 0.875rem; font-weight: 500; color: var(--color-rule); pointer-events: none; }
  .sim-trace { fill: none; stroke: var(--color-rule); opacity: 0.55; }
  .sim-frame { fill: none; stroke-linecap: round; opacity: 0.7; }
  .sim-under { fill: none; stroke: var(--color-navy); stroke-opacity: 0.3; stroke-linecap: round; stroke-linejoin: round; }
  .sim-joint { fill: var(--color-white); stroke: var(--color-navy); }
  .sim-fixed { fill: var(--color-navy); }
  .sim-fixed-eye { fill: var(--color-white); }
  .sim-handle { fill: color-mix(in oklab, var(--color-sky) 30%, transparent); stroke: var(--color-navy); stroke-dasharray: 3 3; pointer-events: none; }
  .sim-label { font-family: var(--font-mono); font-variant-numeric: tabular-nums; fill: var(--color-ink); paint-order: stroke; stroke: var(--color-panel); stroke-width: 0.35em; stroke-linejoin: round; }

  .sim-move { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 0.875rem; margin-top: 0.875rem; }
  .sim-move label, .sim-setting label { font-size: 0.9375rem; font-weight: 500; }
  .sim-move .btn { min-width: 5.25rem; }
  .sim-key { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem 0.5rem; margin-top: 0.75rem; }
  .sim-key span { display: inline-block; flex: none; width: 0.6875rem; height: 0.6875rem; border-radius: 9999px; margin-left: 0.75rem; }
  .sim-key span:first-child { margin-left: 0; }
  .sim-key-fixed { background: radial-gradient(circle, var(--color-white) 0 28%, var(--color-navy) 30%); }
  .sim-key-joint { background: var(--color-white); border: 1.5px solid var(--color-navy); }
  .sim-key-handle { background: color-mix(in oklab, var(--color-sky) 30%, white); border: 1.5px dashed var(--color-navy); }

  .sim input[type="range"] { appearance: none; -webkit-appearance: none; width: 100%; height: 2.75rem; margin: 0; background: transparent; cursor: pointer; }
  .sim input[type="range"]::-webkit-slider-runnable-track { height: 0.25rem; background: var(--table-line); }
  .sim input[type="range"]::-moz-range-track { height: 0.25rem; background: var(--table-line); }
  .sim input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 0.75rem; height: 1.5rem; margin-top: -0.625rem; border: 0; border-radius: 0; background: var(--color-navy); }
  .sim input[type="range"]::-moz-range-thumb { width: 0.75rem; height: 1.5rem; border: 0; border-radius: 0; background: var(--color-navy); }
  .sim input[type="range"]:focus-visible { outline: 2px solid var(--color-navy); outline-offset: 2px; }
  .sim .btn:disabled { cursor: not-allowed; border: 1px dashed var(--color-rule); background: var(--color-panel); color: var(--color-rule); transform: none; }

  .sim-title { margin-top: 0.375rem; font-size: clamp(1.5rem, 1.3rem + 0.9vw, 2rem); font-weight: 600; line-height: 1.15; letter-spacing: -0.016em; color: var(--color-navy); text-wrap: balance; }
  .sim-body { margin-top: 1rem; max-width: 36rem; }
  .sim-body p + p { margin-top: 0.75rem; }
  .sim-setting { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 0.25rem 1rem; margin-top: 1.25rem; }
  .sim-choices { display: flex; flex-wrap: wrap; border: 1px solid var(--color-navy); width: fit-content; }
  .sim-choice { padding: 0.5rem 0.875rem; font-size: 0.9375rem; font-weight: 600; line-height: 1.3; color: var(--color-navy); cursor: pointer; transition: background-color 160ms, color 160ms; }
  .sim-choice:hover { background: var(--navy-tint); }
  .sim-choice[aria-pressed="true"] { background: var(--color-navy); color: var(--color-white); }
  .sim-says { margin-top: 0.875rem; max-width: 36rem; font-size: 0.9375rem; line-height: 1.55; }

  .sim-question { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--table-line); }
  .sim-question h3 { max-width: 34rem; font-size: 1.0625rem; font-weight: 600; line-height: 1.4; color: var(--color-navy); }
  .sim-answers { display: grid; gap: 0.5rem; margin-top: 0.875rem; max-width: 34rem; }
  .sim-answer { display: flex; align-items: center; gap: 0.625rem; min-height: 2.75rem; padding: 0.5rem 0.875rem; border: 1px solid var(--color-navy); text-align: left; font-size: 0.9375rem; font-weight: 500; line-height: 1.35; color: var(--color-navy); cursor: pointer; transition: background-color 160ms; }
  .sim-answer:hover { background: var(--navy-tint); }
  .sim-answer.is-right { background: var(--color-lime); border-color: var(--lime-edge); font-weight: 600; }
  .sim-answer.is-wrong { border-style: dashed; border-color: var(--color-rule); color: var(--color-rule); }
  .sim-answer svg { flex: none; }
  .sim-verdict { margin-top: 0.75rem; max-width: 34rem; font-size: 0.9375rem; line-height: 1.5; min-height: 1.5em; }

  @media (max-width: 30rem) {
    .sim-move { grid-template-columns: auto minmax(0, 1fr); }
    .sim-move label { grid-column: 1 / -1; grid-row: 1; }
    .sim-setting { grid-template-columns: minmax(0, 1fr); }
  }
</style>
