---
import '../styles/home.css';
import Base from '../layouts/BaseLayout.astro';
---

<Base title="HelpingHand">
  <div class="ambient" aria-hidden="true">
    <div class="ambient-glow"></div>
    <div class="ambient-grid"></div>
    <div class="ambient-spot"></div>
  </div>
  <section class="home">
    <div class="home-copy">
      <p class="kicker">Modular robotics</p>
      <h1 data-text="HelpingHand">HelpingHand</h1>
      <p class="lede">A robotic hand students build, wire, and program. Mechanics, circuits, and code, one lesson at a time.</p>
      <div class="home-actions">
        <a class="home-btn solid" href="/lessons">Go to lessons</a>
        <a class="home-btn glass" href="/lessons/01-finger-module">Start lesson 1</a>
      </div>
    </div>
    <figure class="home-visual">
      <img src="/images/hand-placeholder.svg" alt="Placeholder for the HelpingHand robotic hand. Replace this image later." />
    </figure>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Build. Code. Discover.</span>
      <span>Engineering in your hands.</span>
      <span>Build. Code. Discover.</span>
      <span>Engineering in your hands.</span>
      <span>Build. Code. Discover.</span>
      <span>Engineering in your hands.</span>
      <span>Build. Code. Discover.</span>
      <span>Engineering in your hands.</span>
    </div>
  </div>

  <section class="band about reveal" id="about">
    <div class="stagger">
      <p class="kicker">01 / A helping hand</p>
      <h2>Big ideas start with a little <em>hands-on thinking.</em></h2>
      <p>HelpingHand brings mechanics, electronics, and programming together in one modular robotics project. A tangible way for students to explore how engineering turns an idea into movement.</p>
    </div>
  </section>

  <section class="band reveal" id="product">
    <div class="band-head stagger">
      <p class="kicker">02 / Meet the mechanism</p>
      <h2>Engineered for hands-on learning.</h2>
    </div>
    <div class="card-grid stagger">
      <article class="panel">
        <p class="kicker">01 / Mechanics</p>
        <h3>Small links. Coordinated movement.</h3>
        <p>The proposed fingers use a scissor mechanism. Explore how connected links translate motion through each finger.</p>
      </article>
      <article class="panel">
        <p class="kicker">02 / Electronics</p>
        <h3>A little power. A lot to explore.</h3>
        <p>An Arduino Mega, six positional servos, and a three-axis gyroscope and accelerometer form the planned electronic system.</p>
      </article>
      <article class="panel">
        <p class="kicker">03 / Programming</p>
        <h3>From your code to its fingertips.</h3>
        <p>Open and close inputs guide the hand toward its target position. The proposed control logic includes fault checks and LED status feedback.</p>
      </article>
    </div>
    <div class="stagger">
      <a class="home-btn solid" href="/lessons">Start learning</a>
    </div>
  </section>

  <section class="band learn reveal" id="learn">
    <div class="stagger">
      <p class="kicker">03 / Learning through making</p>
      <h2>Learn through experimentation.</h2>
      <p>Designed for students learning engineering and robotics. Follow the connections from physical parts to circuits to the code that brings them together.</p>
    </div>
    <ol class="steps stagger">
      <li>
        <span>01</span>
        <div>
          <h3>Discover the parts.</h3>
          <p>Get to know the fingers, palm, base, and mechanical linkages.</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <h3>Connect the ideas.</h3>
          <p>Explore how the controller, power supply, sensors, and servos work together.</p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <h3>Make your next move.</h3>
          <p>Investigate the control logic. Test, observe, and use what you learn to improve the design.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="band reveal" id="team">
    <div class="band-head stagger">
      <p class="kicker">04 / The hands behind the hand</p>
      <h2>Meet HandiWorks.</h2>
      <p>Four students. One shared curiosity. Created for EG-UY 1004 at NYU Tandon School of Engineering.</p>
    </div>
    <div class="team-grid stagger">
      <article>
        <p class="initial">BJ</p>
        <h3>Billy Jin</h3>
        <p>Programming Lead</p>
      </article>
      <article>
        <p class="initial">GK</p>
        <h3>Golam Khan</h3>
        <p>Design Lead</p>
      </article>
      <article>
        <p class="initial">CL</p>
        <h3>Clarence Li</h3>
        <p>Circuitry Lead</p>
      </article>
      <article>
        <p class="initial">LZ</p>
        <h3>Lingbo Zhang</h3>
        <p>Project Manager</p>
      </article>
    </div>
  </section>

  <section class="band close reveal">
    <div class="stagger">
      <p class="kicker">Your next big idea starts here.</p>
      <h2>Your next idea. In your hands.</h2>
      <a class="home-btn solid" href="/login">
        Enter learning lab
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>

  <script>
    const spot = document.querySelector('.ambient-spot');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (spot && !reduce) {
      let x = window.innerWidth * 0.7;
      let y = window.innerHeight * 0.3;
      let tx = x;
      let ty = y;
      window.addEventListener('pointermove', (event) => {
        tx = event.clientX;
        ty = event.clientY;
        spot.style.opacity = '1';
      });
      const tick = () => {
        x += (tx - x) * 0.08;
        y += (ty - y) * 0.08;
        spot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
        requestAnimationFrame(tick);
      };
      tick();
    }

    const reveal = document.querySelectorAll('.reveal');
    if (reduce) {
      reveal.forEach((section) => section.classList.add('in'));
    } else if (reveal.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
      );
      reveal.forEach((section) => observer.observe(section));
    }
  </script>
</Base>
