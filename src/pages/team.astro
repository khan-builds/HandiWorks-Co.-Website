---
/** The team, and what it does next. Since 2026-11-25 the Roadmap is a section of this page
    ("Roadmap", `#next`): on its own it was four lines, and /roadmap/ now sends the reader here.
    The four next steps are from the team's final prototype poster (24 Nov 2026), in the
    poster's order. Since 2026-11-25 each is a plain sentence and not the poster's shorthand
    ("Finalize website backend"). Nothing in them is invented: no dates, no owners. The one
    thing added is what the backend is for, real accounts, which the dashboards already say
    are missing. A fuller roadmap is still Lingbo's to write.
    Each person's address is on their row and in the footer of every page. "Talk to us" is
    the one button that writes to all four. */
import Base from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { asset, KIT_REQUEST } from '../lib/url';
import { team } from '../lib/team';

const initials = (name: string) => name.split(' ').map((w) => w[0]).join('');

const nextSteps = [
  'Get feedback on Lesson 1 and on the hand’s design.',
  'Make the hand about half its current size.',
  'Finish the website’s backend, so a class signs in with real accounts.',
  'Write Lessons 2 to 4.',
];
---
<Base title="Team" description="The four people behind HelpingHand and HandiWorks Co., and what they do next.">
  <PageHeader title="Meet HandiWorks." lede="Four engineers who think the best way to learn how something works is to build it, break it, and build it again." />

  <section class="section">
    <SectionLabel>The team</SectionLabel>
    <div class="split">
      <div>
        <p class="statement">Founded at NYU Tandon, 2026, as a <span class="whitespace-nowrap">Semester-Long</span> Design Project.</p>
        <p class="measure mt-5">HelpingHand started as the answer to a simple question: why does learning robotics cost so much, and why is it taught as three separate subjects?</p>
      </div>
      <ul class="border-t border-navy">
        {team.map((m) => (
          <li class="flex items-center gap-5 border-b border-edge py-4">
            {m.photo
              ? <img class="h-16 w-16 shrink-0 object-cover" src={asset(m.photo)} alt={`Portrait of ${m.name}`} />
              : <div class="grid h-16 w-16 shrink-0 place-items-center bg-navy text-lead font-bold tracking-tight text-white" aria-hidden="true">{initials(m.name)}</div>}
            <div class="min-w-0 flex-1 sm:flex sm:items-center sm:justify-between sm:gap-6">
              <div>
                <h3 class="text-lead">{m.name}</h3>
                <p class="font-semibold">{m.role}</p>
                {m.bio && <p class="measure mt-1 text-small text-rule">{m.bio}</p>}
              </div>
              {/* A narrow column breaks the address at the @ before it breaks anywhere else. */}
              <p class="text-small"><a class="link [overflow-wrap:anywhere]" href={`mailto:${m.email}`}>{m.email.split('@')[0]}<wbr />@{m.email.split('@')[1]}</a></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="next">
    <SectionLabel>Roadmap</SectionLabel>
    <div class="split">
      <p class="statement">What the team does next.</p>
      <ol class="numbered">
        {nextSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="band band-close">
    <div class="wrap">
      <SectionLabel>Talk to us</SectionLabel>
      <div class="split">
        <p class="statement text-white">Teachers, schools, and makers: we want to hear what you would do with a hand like this.</p>
        <div>
          <p class="measure text-(--on-navy-soft)">Kits are not for sale yet. Tell us your school, the grade and the class size.</p>
          <a class="btn btn-primary mt-6" href={KIT_REQUEST}>Request a kit</a>
        </div>
      </div>
    </div>
  </section>
</Base>
