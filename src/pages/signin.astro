---
import Base from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Arrow from '../components/Arrow.astro';

/** The classroom demo's front door. The address is still /signin/ so old links keep working,
    but nothing here signs anyone in: it sets a role in this browser (localStorage, hh-role).
    A link can skip the choice: /signin/?as=teacher goes straight to the teacher dashboard,
    and &to=/dashboard/student/simulator/ names another page inside the site (see demo() in
    src/lib/url.ts). The homepage uses the same links, written by hand. */
const roles = [
  { key: 'teacher', title: 'Explore as a teacher', body: 'A class, each student’s progress through Lesson 1, and what is assigned.' },
  { key: 'student', title: 'Explore as a student', body: 'Your progress through Lesson 1, what is due next, and the simulator.' },
];
---
<Base title="Classroom demo" description="See HelpingHand as a teacher or as a student would. A made-up class, no account needed.">
  {/* Before anything is drawn: a link that already names its role goes straight through. */}
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    (() => {
      const q = new URLSearchParams(location.search), role = q.get('as'), to = q.get('to');
      if (role !== 'teacher' && role !== 'student') return;
      try { localStorage.setItem('hh-role', role); } catch {}
      const root = base.replace(/\/+$/, '');
      // Only a plain path inside this site is followed.
      const inside = to && /^\/[a-z0-9\-\/]*$/i.test(to) && !to.startsWith('//');
      location.replace(root + (inside ? to : `/dashboard/${role}/`));
    })();
  </script>
  <PageHeader title="See it as a teacher or a student." lede="A made-up class, with no account needed. Pick a side of the classroom." />

  <section class="section" data-signin data-base={import.meta.env.BASE_URL}>
    <SectionLabel>Choose a role</SectionLabel>
    <p class="note mt-8 max-w-3xl" data-wanted hidden></p>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {roles.map((r) => (
        <button type="button" class="panel flex h-full flex-col items-stretch justify-start p-7 md:p-9" data-role={r.key}>
          <span class="flex items-start justify-between gap-6">
            <span class="text-[1.625rem] font-bold leading-tight tracking-[-0.02em] text-navy">{r.title}</span>
            <Arrow class="mt-1.5 text-2xl text-navy" />
          </span>
          <span class="mt-3 block max-w-[38ch] text-rule">{r.body}</span>
          <span class="badge badge-live mt-5 self-start" data-current hidden>Your role now</span>
        </button>
      ))}
    </div>
    <p class="mt-8" data-leave hidden>
      <button type="button" class="btn btn-secondary">Leave the demo</button>
    </p>
  </section>

  <script>
    const root = document.querySelector<HTMLElement>('[data-signin]')!;
    const base = (root.dataset.base || '/').replace(/\/+$/, '');
    const wanted = new URLSearchParams(location.search).get('role');
    const current = localStorage.getItem('hh-role');

    // Sent here by a dashboard: say which role opens it.
    const hint = root.querySelector<HTMLElement>('[data-wanted]')!;
    if (wanted === 'teacher' || wanted === 'student') {
      hint.textContent = `Pick the ${wanted} role to open the ${wanted} dashboard.`;
      hint.hidden = false;
    }

    root.querySelectorAll<HTMLButtonElement>('[data-role]').forEach((button) => {
      const role = button.dataset.role!;
      if (role === current) button.querySelector<HTMLElement>('[data-current]')!.hidden = false;
      button.addEventListener('click', () => {
        localStorage.setItem('hh-role', role);
        location.href = `${base}/dashboard/${role}/`;
      });
    });

    const leave = root.querySelector<HTMLElement>('[data-leave]')!;
    if (current) leave.hidden = false;
    leave.querySelector('button')!.addEventListener('click', () => {
      localStorage.removeItem('hh-role');
      location.href = `${base}/`;
    });
  </script>
</Base>
