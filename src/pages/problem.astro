---
/** The Problem. Two halves, in Lingbo's words of 2026-11-24: schools do not have access to
    robotics, and the options they do have are bad. Figures are in src/data/evidence.ts, the
    comparison and its rules in src/data/compare.ts. Nothing on this page is stated without a
    source a reader can open, and every other maker's product is described from that maker's
    own pages. The motion is Anime.js (src/scripts/problem/motion.ts), on this page only: the
    page reads the same with scripting off and with reduced motion. */
import Base from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Stat from '../components/Stat.astro';
import { p } from '../lib/url';
import { headline, sections, uncounted, notes, gap } from '../data/evidence';
import { options, manual, research, guidance, market, strip, totals, GROUPS, LISTS, RATINGS, CHECKED, CONCEPT_COUNT, type Src, type Mark } from '../data/compare';
import { LEFT, RIGHT, SHAPES, pose, trace } from '../scripts/problem/linkage';

/** A link on this site needs the base path; a link to another site does not. */
const href = (url: string) => (url.startsWith('/') ? p(url) : url);
const outside = (url: string) => !url.startsWith('/');

const others = options.filter((o) => !o.ours);
const byBuild = (kind: string) => others.filter((o) => o.build.kind === kind).map((o) => o.maker);
const list = (names: string[]) => (names.length < 2 ? names.join('') : names.slice(0, -1).join(', ') + ' and ' + names.at(-1));
const number = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];

const columns = [
  { key: 'cost', label: 'Cost of one kit' },
  { key: 'ages', label: 'Ages' },
  { key: 'more', label: 'Cost to go further' },
  { key: 'build', label: 'How the robot gets built' },
  { key: 'mechanics', label: 'Mechanics' },
  { key: 'circuits', label: 'Circuits' },
  { key: 'code', label: 'Code' },
] as const;

const MARKS: Record<Mark, { letter: string; word: string }> = {
  E: { letter: 'E', word: 'Explained' },
  S: { letter: 'S', word: 'Built from steps' },
  M: { letter: 'M', word: 'Made by the student' },
  W: { letter: '*', word: 'Planned, not taught yet (WIP)' },
};

const figures = [...sections.flatMap((s) => s.figures), ...uncounted];

const sources = new Map<string, string>();
const cite = (s?: Src) => s && outside(s.url) && sources.set(s.label, s.url);
for (const f of [gap, ...headline, ...figures, notes.retired, notes.nextSurvey]) sources.set(f.source, f.url);
for (const o of others) for (const c of [o.reach, o.cost, o.ages, o.more, o.build, o.circuits, o.code]) cite(c.src);
for (const r of research) cite(r.src);
[guidance.src, market, manual.about, manual.advice].forEach(cite);
const widest = Math.max(gap.highPoverty.fill, gap.lowPoverty.fill);

/* The drawing. Its still form is the linkage a third of the way round, with the path its
   fingertip draws; the script moves the same parts. */
const still = pose(2.1, SHAPES[0]);
const pt = (q: number[]) => q.map((v) => v.toFixed(1)).join(',');
---
<Base title="The Problem" description="Few schools have robotics, and the kits they can buy have students follow a manual. With a source for every number.">
  <PageHeader
    title="Robotics currently isn’t hands-on for everyone."
    lede="Popular robotics kits for young students can be extremely costly, creating a high barrier for entry for schools that want to invest in engineering programs. Furthermore, many existing robotics kits are uninspired, having students follow a manual."
  >
    {/* The poster's stat panel: two numbers side by side, each with its label in capitals and
        a bar. The longer bar is full width and the shorter one is in proportion to it. */}
    <div slot="aside" class="w-full max-w-md lg:w-[26rem]" data-reveal data-count>
      <p class="stat-caption">{gap.caption}</p>
      <div class="mt-5 grid grid-cols-2 gap-x-8">
        {[gap.highPoverty, gap.lowPoverty].map((g, i) => (
          <div class="grid grid-rows-subgrid row-span-3">
            <p class:list={['stat-number', i === 1 && 'stat-number-plain']}>{g.value}</p>
            <p class="stat-label-caps mt-3" title={g.label}>{g.short}</p>
            <div class="stat-bar" aria-hidden="true"><span style={`--stat-fill:${(g.fill / widest) * 100}%`}></span></div>
          </div>
        ))}
      </div>
      <p class="stat-source pt-6!">{gap.detail} <a href={gap.url} target="_blank" rel="noopener">{gap.source}</a>, {gap.year}</p>
    </div>
  </PageHeader>

  <section class="section">
    <SectionLabel>Few schools have it</SectionLabel>
    <p class="statement mt-6">Most middle schools have no team in any engineering competition, robotics included.</p>
    <div class="stat-group mt-8" data-count>
      {headline.map((f) => <Stat figure={f} variant="panel" />)}
    </div>
    <p class="meta mt-4">Every number on this page links to its source and carries its year. The school figures are from the 2018 NSSME+, a national survey of 1,273 schools and 7,600 teachers and the most recent of its kind. <a class="link" href="#all-figures">All {figures.length} other figures</a> are further down.</p>
  </section>

  <section class="section">
    <SectionLabel>What schools can buy today</SectionLabel>
    <p class="statement mt-6">Can you rebuild a LEGO set without the booklet?</p>
    <p class="lede mt-3">A booklet gets you to a finished model. It does not say why the model works, so the next model needs another booklet. {number[byBuild('steps').length]} of the five options below hand the student a manual in the same way: supplied parts, numbered steps, a finished robot.</p>
    <p class="lede mt-3">The trouble is not the steps. Beginners learn better with a guide than without one. The trouble is steps with no reasons: a manual shows where each part goes, not why the design works.</p>

    {/* The drawing: follow the steps on the left, change the linkage on the right. */}
    <div class="duo mt-10" data-duo>
      <figure class="duo-panel">
        <svg viewBox="0 0 280 190" role="img" aria-label="A robot assembled in five numbered steps. It is the same robot every time.">
          <g class="duo-ticks">
            {[1, 2, 3, 4, 5].map((n) => (
              <g data-tick={n} transform={`translate(${20 + (n - 1) * 30} 22)`}>
                <circle r="10" />
                <text y="4" text-anchor="middle">{n}</text>
              </g>
            ))}
          </g>
          <g class="duo-robot">
            <rect data-part="1" x="80" y="118" width="130" height="16" />
            <g data-part="2"><circle cx="104" cy="146" r="14" /><circle cx="186" cy="146" r="14" /></g>
            <rect data-part="3" x="94" y="66" width="14" height="52" />
            <rect data-part="4" x="94" y="60" width="92" height="12" />
            <g data-part="5"><rect x="186" y="50" width="26" height="8" /><rect x="186" y="74" width="26" height="8" /><rect x="180" y="50" width="8" height="32" /></g>
          </g>
        </svg>
        <figcaption><strong>Follow the steps.</strong> The same robot every time.</figcaption>
      </figure>
      <figure class="duo-panel">
        <svg viewBox="0 0 280 190" role="img" aria-label="A four-bar linkage with a fingertip. When the length of a bar changes, the path of the fingertip changes.">
          <polyline class="duo-trace" data-trace points={trace(SHAPES[0])} />
          <line class="duo-frame" x1={LEFT[0]} y1={LEFT[1]} x2={RIGHT[0]} y2={RIGHT[1]} />
          <polyline class="duo-rod" data-rod points={`${pt(still.b)} ${pt(still.c)} ${pt(still.tip)}`} />
          <line class="duo-crank" data-crank x1={LEFT[0]} y1={LEFT[1]} x2={still.b[0].toFixed(1)} y2={still.b[1].toFixed(1)} />
          <line class="duo-rocker" data-rocker x1={RIGHT[0]} y1={RIGHT[1]} x2={still.c[0].toFixed(1)} y2={still.c[1].toFixed(1)} />
          <circle class="duo-fixed" cx={LEFT[0]} cy={LEFT[1]} r="6" /><circle class="duo-fixed" cx={RIGHT[0]} cy={RIGHT[1]} r="6" />
          <circle class="duo-pin" data-pin-b cx={still.b[0].toFixed(1)} cy={still.b[1].toFixed(1)} r="4" />
          <circle class="duo-pin" data-pin-c cx={still.c[0].toFixed(1)} cy={still.c[1].toFixed(1)} r="4" />
          <circle class="duo-tip" data-tip cx={still.tip[0].toFixed(1)} cy={still.tip[1].toFixed(1)} r="6" />
        </svg>
        <figcaption><strong>Change one bar.</strong> A different motion every time. <a class="link" href={p('/dashboard/student/simulator/')}>Try it in the Simulator</a> (a demo: sign in as a student).</figcaption>
      </figure>
    </div>

    <div class="mt-12 grid items-start gap-x-12 gap-y-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div>
        <h3 class="text-xl">What a competition kit starts with</h3>
        <p class="mt-3">This season’s starter robot for the VEX V5 competition is called Flex, and it is built from the V5 Competition Starter Kit. Its manual is <strong>{manual.pages} pages</strong>, one assembly picture to a page.</p>
        <p class="mt-3">VEX’s own guide recommends “to start with a set of instructions” before “assembling your first custom-designed robot”, and adds that “the next adventure will be designing your own robot”. The manual gets a team to a working robot. Designing the next one is left for later.</p>
        <p class="meta mt-4">Sources: <a class="link" href={manual.about.url} target="_blank" rel="noopener">{manual.about.label}</a>; <a class="link" href={manual.advice.url} target="_blank" rel="noopener">{manual.advice.label}</a>. Checked 24 Nov 2026.</p>
      </div>
      <div class="manual" data-manual={manual.pdf}>
        <div class="manual-frame" data-manual-frame hidden></div>
        <div class="manual-bar">
          <button type="button" class="btn btn-primary manual-open" data-manual-open hidden>Open the manual here</button>
          <a class="btn btn-secondary" href={manual.pdf} target="_blank" rel="noopener">Open it on VEX’s site</a>
        </div>
        <p class="meta mt-3">{manual.pages} pages, 18 MB, loaded from VEX’s own server when you ask for it. Build instructions © VEX Robotics, Inc. We show them as VEX publishes them and keep no copy.</p>
      </div>
    </div>

    <h3 class="mt-12 text-xl">What researchers say about building from steps</h3>
    <div class="mt-4 grid items-start gap-x-12 gap-y-5 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <ul class="quotes">
        {research.map((r) => (
          <li><span class="quote-text">“{r.quote}”</span> <span class="meta"><a class="link" href={r.src.url} target="_blank" rel="noopener">{r.who}</a>. {r.note}</span></li>
        ))}
      </ul>
      <p class="note"><strong>The other side.</strong> “{guidance.quote}” (<a class="link" href={guidance.src.url} target="_blank" rel="noopener">Kirschner, Sweller and Clark, 2006</a>). Nobody has counted how many kits are built from steps, and no study shows that steps harm learning. What the research supports is narrower: steps alone do not teach why.</p>
    </div>

    <h3 id="compare" class="mt-12 scroll-mt-24 text-xl">Five widely used options</h3>
    <p class="lede mt-3">{list(byBuild('steps'))} ship a manual for a set robot. {list(byBuild('none'))} has nothing to build. {list(byBuild('own'))} asks students to design their own, and costs about $1,850 to start. HelpingHand is the last row: a prototype, rated by the same rules.</p>

    <div class="cmp mt-8" data-cmp>
      <table class="cmp-table">
        <colgroup><col style="width:14%" /><col style="width:10.5%" /><col style="width:8%" /><col style="width:11%" /><col style="width:15.5%" /><col style="width:12.5rem" /><col /><col /></colgroup>
        <thead>
          <tr>
            <th scope="col">Option</th>
            {columns.map((c) => <th scope="col">{c.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {options.map((o) => {
            const cells = strip(o.key), t = totals(o.key);
            return (
              <tr class:list={['cmp-row', o.ours && 'cmp-ours']}>
                <th scope="row">
                  <span class="cmp-maker">{o.maker}</span>
                  <span class="cmp-name">{o.name}</span>
                  <span class="cmp-reach" title={o.reach.detail}>{o.reach.src ? <a class="link" href={href(o.reach.src.url)} target="_blank" rel="noopener">{o.reach.text}</a> : o.reach.text}</span>
                </th>
                {(['cost', 'ages', 'more'] as const).map((k, i) => (
                  <td data-label={columns[i].label}>
                    <p class:list={['cmp-value', o[k].tbc && 'cmp-tbc']}>{o[k].src ? <a class="link" href={href(o[k].src!.url)} target={outside(o[k].src!.url) ? '_blank' : undefined} rel="noopener">{o[k].text}</a> : o[k].text}</p>
                    {o[k].detail && <p class="cmp-detail">{o[k].detail}</p>}
                  </td>
                ))}
                <td data-label="How the robot gets built">
                  <p class:list={['cmp-tag', `cmp-tag-${o.build.kind}`]}>{o.build.tag}</p>
                  <p class="cmp-detail">{o.build.src ? <a class="link" href={href(o.build.src.url)} target={outside(o.build.src.url) ? '_blank' : undefined} rel="noopener">{o.build.text}</a> : o.build.text}</p>
                </td>
                <td data-label="Mechanics">
                  <div class="strip" role="img" aria-label={`Mechanics: ${t.explained} of ${CONCEPT_COUNT} concepts explained, ${t.made} made by the student${t.wip ? `, ${t.wip} planned` : ''}`}>
                    {cells.map((c) => (
                      <span class:list={['strip-cell', c.made > 0 && 'is-made', c.wip > 0 && 'is-wip']} style={`--share:${c.explained / c.of}`} title={`${c.name}: ${c.explained} of ${c.of} explained${c.made ? `, ${c.made} made by the student` : ''}${c.wip ? `, ${c.wip} planned * (WIP)` : ''}`}>
                        <span>{c.explained || (c.wip ? '' : '0')}{c.wip > 0 && '*'}</span>
                      </span>
                    ))}
                  </div>
                  <p class="cmp-detail">{t.explained} of {CONCEPT_COUNT} explained, {t.made} made by the student{t.wip > 0 && <>, {t.wip} more * (WIP)</>}{o.mechanicsNote && <>. {o.mechanicsNote}</>}</p>
                </td>
                {(['circuits', 'code'] as const).map((k) => (
                  <td data-label={k === 'circuits' ? 'Circuits' : 'Code'}>
                    <p class="cmp-detail cmp-plain">{o[k].src ? <a class="link" href={href(o[k].src!.url)} target={outside(o[k].src!.url) ? '_blank' : undefined} rel="noopener">{o[k].text}</a> : o[k].text}</p>
                  </td>
                ))}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="cmp-key mt-4">
      <p class="meta"><span class="strip-cell key-cell" style="--share:0.6"><span>3</span></span> One square for each group of mechanics concepts, in this order: {GROUPS.map((g) => g.short.toLowerCase()).join('; ')}. The number is how many of that group’s concepts an official lesson explains.</p>
      <p class="meta"><span class="strip-cell key-cell is-made" style="--share:0.6"><span>3</span></span> The student makes at least one of them: draws or designs it, not only assembles it.</p>
      <p class="meta"><span class="strip-cell key-cell is-wip" style="--share:0"><span>*</span></span> Planned for HelpingHand, with no lesson on this site yet: * (WIP).</p>
    </div>
    <p class="mt-5"><a class="btn btn-secondary" href="#how-we-compare" data-method-open>How we compare</a></p>
    <p class="meta mt-3">Each cell links to the maker’s page it was read on. “To be confirmed” marks what nobody on the team has read there yet. The four makers are the ones <a class="link" href={market.url} target="_blank" rel="noopener">a market-research firm’s estimate</a> names as the largest in schools.</p>
  </section>

  <section class="band mt-[clamp(3.25rem,2.25rem+4vw,5.25rem)]">
    <div class="wrap py-14 md:py-20">
      <SectionLabel>What HelpingHand changes</SectionLabel>
      <div class="mt-8 grid gap-x-16 gap-y-10 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="statement text-white">Every student deserves the chance to build a foundation in robotics.</p>
          <p class="mt-4 text-(--on-navy-soft)">We are not trying to replace competition robotics. We are going after what comes before it: the kits and the curriculum students start with. This is our first prototype aimed at solving this issue.</p>
          {/* The poster's goal, bold on the same words. */}
          <p class="mt-4 text-(--on-navy-soft)">Our goal is to <strong class="text-white">transform</strong> how robotics is taught in the classroom, fostering the highest level of creativity while prioritizing accessibility.</p>
        </div>
        <ol class="numbered on-navy">
          <li>Provide a <strong>scalable</strong> framework that evolves alongside the learner.</li>
          <li>Offer an <strong>affordable</strong> and <strong>accessible</strong> alternative to traditional robotics kits (FIRST, VEX, LEGO, etc.)</li>
        </ol>
      </div>
      <div class="columns mt-12">
        <div>
          <h3 class="text-xl">Printed, not bought</h3>
          <p class="mt-2 text-(--on-navy-soft)">3D printers provide an affordable alternative that allows multiple students to print an unlimited number of parts.</p>
        </div>
        <div>
          <h3 class="text-xl">A standard controller</h3>
          <p class="mt-2 text-(--on-navy-soft)">The hand runs on an Arduino Mega 2560, <a class="link" href={p('/kit/#cost')}>$22.99 in our cost table</a>.</p>
        </div>
        <div>
          <h3 class="text-xl">One lesson at a time</h3>
          <p class="mt-2 text-(--on-navy-soft)">Students learn mechanics, circuits, and coding one lesson at a time, not by following a manual.</p>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={p('/kit/')}>See the kit</a>
        <a class="btn btn-secondary" href={p('/lessons/beginner/')}>Browse the lessons</a>
      </div>
    </div>
  </section>

  <section class="section" id="all-figures">
    <details class="more" data-more>
      <summary><span class="more-title">All the figures</span><span class="meta">{figures.length} more, each with its source: access, hands-on work in class, kit prices, teachers, evidence, and what nobody counts</span></summary>
      {sections.map((s) => (
        <div class="mt-10">
          <SectionLabel as="h3" class="section-label-sm">{s.label}</SectionLabel>
          <p class="statement mt-5">{s.title}</p>
          <p class="lede mt-3">{s.intro}</p>
          <div class="figure-list mt-6">
            {s.figures.map((f) => <Stat figure={f} />)}
          </div>
        </div>
      ))}
      <div class="mt-10">
        <SectionLabel as="h3" class="section-label-sm">What nobody counts</SectionLabel>
        <p class="statement mt-5">How many schools teach robotics specifically? Nobody knows for sure.</p>
        <p class="lede mt-3">The last national count of robotics courses is more than a decade old. The school survey this page leans on is from 2018, and <a class="link" href={notes.nextSurvey.url} target="_blank" rel="noopener">the next one was announced for 2027</a>. The national test of technology and engineering skills <a class="link" href={notes.retired.url} target="_blank" rel="noopener">was retired in 2023</a>. We show each figure with its date rather than pretend a newer number exists.</p>
        <div class="figure-list mt-6">{uncounted.map((f) => <Stat figure={f} />)}</div>
      </div>
    </details>
  </section>

  <section class="section more-next" id="sources">
    <details class="more">
      <summary><span class="more-title">Sources</span><span class="meta">{sources.size} documents and pages. Figures were checked against them in October and November 2026.</span></summary>
      <p class="lede mt-6">Vendor prices change, so each one carries the year it was read.</p>
      <ol class="mt-6 list-decimal gap-x-16 pl-6 text-[0.9375rem] marker:font-semibold marker:text-navy md:columns-2">
        {[...sources.entries()].map(([name, url]) => (
          <li class="mb-2 break-inside-avoid pl-1"><a class="link" href={url} target="_blank" rel="noopener">{name}</a></li>
        ))}
      </ol>
    </details>
  </section>

  {/* "How we compare": the rules behind the table and every rating, in a window that opens
      over the page. With scripting off it is an ordinary section at the foot of the page. */}
  <dialog class="method" id="how-we-compare" aria-labelledby="method-title">
    <div class="method-head">
      <h2 id="method-title" class="text-xl">How we compare</h2>
      <button type="button" class="btn btn-secondary method-close" data-method-close>Close</button>
    </div>
    <div class="method-body">
      <p>Checked on 24 Nov 2026. Say so if a cell is wrong: <a class="link" href={p('/team/')}>the team’s addresses are on the Team page</a>.</p>

      <h3 class="mt-7 text-lg">The rules</h3>
      <ul class="method-rules mt-3">
        <li><strong>Other makers’ products</strong> are described only from the maker’s or organizer’s own pages. Each cell links to the page it was read on. A blank means we found nothing there, not that nothing exists.</li>
        <li><strong>Cost of one kit</strong> is the price on the maker’s page on the day we checked, with the number of students the maker says one kit serves. <strong>Cost to go further</strong> is the maker’s cheapest official add-on that gives the student something new to build.</li>
        <li><strong>How the robot gets built</strong> is what the maker ships: step-by-step instructions for a set robot, nothing to build, or the student’s own design.</li>
        <li><strong>HelpingHand is rated by the same rules</strong>, from this site as it stands. Anything no lesson here teaches today is marked * (WIP), even where the hand already has the part.</li>
      </ul>

      <h3 class="mt-7 text-lg">What each one does well</h3>
      <ul class="method-rules mt-3">
        {others.map((o) => <li><strong>{o.maker}, {o.name}.</strong> {o.good}</li>)}
      </ul>

      <h3 class="mt-7 text-lg">Mechanics: {CONCEPT_COUNT} concepts from seven public lists</h3>
      <p class="mt-3">We did not write the list of what there is to learn. It is merged from seven lists that robotics teams and teachers already use. The number after a concept says which lists name it.</p>
      <ol class="method-lists mt-3">
        {LISTS.map((l) => <li><a class="link" href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
      </ol>
      <p class="mt-4">A concept can earn three marks for each option:</p>
      <ul class="method-marks mt-3">
        <li><span class="mark mark-E">E</span> <strong>Explained.</strong> An official lesson or help page teaches it by name.</li>
        <li><span class="mark mark-S">S</span> <strong>Built from steps.</strong> The official build instructions for a set robot have the student assemble it.</li>
        <li><span class="mark mark-M">M</span> <strong>Made by the student.</strong> Official material asks the student to draw or design their own.</li>
        <li><span class="mark mark-W">*</span> <strong>Planned (WIP).</strong> HelpingHand only: the hand has it or a lesson is planned, and nothing on this site teaches it yet.</li>
      </ul>
      <p class="mt-4">Three of the seven lists are written around VEX and FIRST parts, so the list leans toward competition robots. A hand has no drivetrain and no launcher, and about twenty of the concepts will never apply to it.</p>
      <p class="mt-4">We marked the others generously. A short mention still earns “explained”, and for VEX and FIRST, guidance on designing a custom robot counts as “made by the student”. Some of FIRST’s marks rest on its 2021–22 Class Pack lesson guides. LEGO’s rest on the one lesson of its 30 that opens without signing in. Sphero’s lessons did not open for our tools, so its column is not checked.</p>
      <p class="mt-4">Of the {CHECKED.quoted} marks that quote a page, {CHECKED.found} were found on their pages on 24 Nov 2026. The other {CHECKED.quoted - CHECKED.found} rest on VEX STEM Lab pages that do not open for our checker. {CHECKED.pictures} more describe a picture in a set of build instructions.</p>

      <div class="table-scroll mt-6">
        <table class="result-table result-table-compact method-grid">
          <thead>
            <tr>
              <th scope="col">Concept</th>
              {options.map((o) => <th scope="col">{o.maker}</th>)}
            </tr>
          </thead>
          <tbody>
            {GROUPS.map((g) => (
              <>
                <tr class="method-group"><th scope="colgroup" colspan={options.length + 1}>{g.name}</th></tr>
                {g.concepts.map((c) => (
                  <tr>
                    <th scope="row">{c.name} <span class="method-lists-of" title={`Named by lists ${c.lists.join(', ')}`}>{c.lists.join(' ')}</span></th>
                    {options.map((o) => (
                      <td>
                        {(RATINGS[o.key][c.n] ?? []).map((r) => r.url
                          ? <a class:list={['mark', `mark-${r.m}`]} href={href(r.url)} target={outside(r.url) ? '_blank' : undefined} rel="noopener" title={`${MARKS[r.m].word}${r.q ? `: “${r.q}”` : r.seen ? `. ${r.seen}` : ''}`}>{MARKS[r.m].letter}<span class="sr-only"> {MARKS[r.m].word}</span></a>
                          : <span class:list={['mark', `mark-${r.m}`]} title={MARKS[r.m].word}>{MARKS[r.m].letter}<span class="sr-only"> {MARKS[r.m].word}</span></span>)}
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta mt-3">Each letter links to the page it rests on. Hover over one to read that page’s words.</p>
    </div>
  </dialog>
</Base>

<style is:global>
