  .cmp-key .meta { display: flex; align-items: flex-start; gap: 0.625rem; }
  .key-cell { flex: none; }
  @media (max-width: 63.99rem) {
    /* Each option becomes its own card: the heading row goes and every cell says what it is. */
    .cmp-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .cmp-table colgroup { display: none; }
    .cmp-table, .cmp-table tbody, .cmp-table tr, .cmp-table th, .cmp-table td { display: block; }
    .cmp-table tr { margin-bottom: 1rem; border: 1px solid var(--table-line); }
    .cmp-table th, .cmp-table td { padding: 0.4375rem 0.75rem; border: 0; border-bottom: 1px solid var(--color-edge); }
    .cmp-table tbody th { padding-block: 0.625rem; background: var(--color-panel); }
    .cmp-table .cmp-ours > th { background: var(--navy-tint); }
    .cmp-table tr > :last-child { border-bottom: 0; }
    .cmp-table td { display: grid; grid-template-columns: 6.75rem minmax(0, 1fr); column-gap: 0.75rem; align-items: baseline; }
    .cmp-table td::before { content: attr(data-label); grid-row: 1 / span 3; font-size: 0.75rem; font-weight: 600; line-height: 1.5; color: var(--color-rule); }
    .cmp-table td > * { grid-column: 2; }
    .cmp-value { font-size: 0.9375rem; }
  }

  /* The strip: nine squares, one for each group of concepts. */
  .strip { display: grid; grid-template-columns: repeat(9, 1.125rem); gap: 2px; }
  .strip-cell { position: relative; display: grid; place-items: center; width: 1.125rem; height: 1.125rem; border: 1px solid var(--table-line); background: linear-gradient(to top, color-mix(in oklab, var(--color-navy) 22%, white) calc(var(--share, 0) * 100%), var(--color-white) 0); font-size: 0.625rem; font-weight: 600; line-height: 1; color: var(--color-navy); font-variant-numeric: tabular-nums; }
