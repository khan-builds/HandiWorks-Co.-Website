  .method { width: min(64rem, calc(100vw - 2rem)); max-width: none; max-height: calc(100vh - 3rem); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; overflow: hidden; border: 2px solid var(--color-navy); background: var(--color-white); color: var(--color-ink); }
  .method::backdrop { background: color-mix(in oklab, var(--color-navy) 55%, transparent); }
