<script>
  import '../scripts/problem/motion.ts';

  // "How we compare": opens over the page, closes with its button, Esc or a click outside.
  const method = document.querySelector<HTMLDialogElement>('#how-we-compare');
  document.querySelector('[data-method-open]')?.addEventListener('click', (event) => {
    if (!method?.showModal) return;
    event.preventDefault();
    method.showModal();
  });
  method?.querySelector('[data-method-close]')?.addEventListener('click', () => method.close());
  method?.addEventListener('click', (event) => { if (event.target === method) method.close(); });

  // The manual loads from VEX only when asked for, and goes away again the same way.
  const manual = document.querySelector<HTMLElement>('[data-manual]');
  const open = manual?.querySelector<HTMLButtonElement>('[data-manual-open]');
  const frame = manual?.querySelector<HTMLElement>('[data-manual-frame]');
  if (manual && open && frame) {
    open.hidden = false;
    open.addEventListener('click', () => {
      const showing = !frame.hidden;
      frame.hidden = showing;
      frame.replaceChildren();
      if (!showing) {
        const view = document.createElement('iframe');
        view.src = `${manual.dataset.manual}#view=FitH`;
        view.title = 'VEX V5 build instructions, shown from VEX’s server';
        view.loading = 'lazy';
        frame.append(view);
      }
      open.textContent = showing ? 'Open the manual here' : 'Close the manual';
    });
  }
</script>
