---
/** The Problem. Two halves, in Lingbo's words of 2026-11-24: schools do not have access to
    robotics, and the options they do have are bad. Figures are in src/data/evidence.ts, the
    comparison and its rules in src/data/compare.ts. Nothing on this page is stated without a
    source a reader can open, and every other maker's product is described from that maker's
    own pages.
    Since 2026-11-25 the main flow is short: the two figures in the header, three more, the
    argument with its drawing, and a comparison of four plain columns with HelpingHand first.
    The figures it leads with are about hands-on work in class and what a kit costs, not about
    competition teams (Lingbo, 2026-11-25): the page ends by saying HelpingHand does not
    replace competition robotics, so it should not open on how few schools have a team.
    What backs it is one click away and off the main flow: the ratings and the rules in the
    "How we compare" window, and the figures, the research and the sources in three rows that
    open. The motion is Anime.js (src/scripts/problem/motion.ts), on this page only: the page
    reads the same with scripting off and with reduced motion. */
import Base from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Stat from '../components/Stat.astro';
import { p, demo } from '../lib/url';
import { headline, sections, uncounted, notes, gap } from '../data/evidence';
import { options, manual, research, guidance, market, strip, totals, GROUPS, LISTS, RATINGS, CHECKED, CONCEPT_COUNT, type Option, type Src, type Mark } from '../data/compare';
import { LEFT, RIGHT, SHAPES, pose, trace } from '../scripts/problem/linkage';

/** A link on this site needs the base path; a link to another site does not. */
const href = (url: string) => (url.startsWith('/') ? p(url) : url);
const outside = (url: string) => !url.startsWith('/');
/** The attributes of a link to a source: another site opens in a new tab. */
const to = (src: Src) => ({ href: href(src.url), ...(outside(src.url) ? { target: '_blank', rel: 'noopener' } : {}) });

const others = options.filter((o) => !o.ours);
/** HelpingHand first, then the others in the order of the data. */
const rows = [...options.filter((o) => o.ours), ...others];
/** What a row is called: ours by its own name, the others by their maker. */
const called = (o: Option) => (o.ours ? o.name : o.maker);
const stepped = others.filter((o) => o.build.kind === 'steps').length;
const number = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];

const MARKS: Record<Mark, { letter: string; word: string }> = {
  E: { letter: 'E', word: 'Explained' },
  S: { letter: 'S', word: 'Built from steps' },
  M: { letter: 'M', word: 'Made by the student' },
  W: { letter: '*', word: 'Planned, not taught yet (WIP)' },
};

const figures = [...sections.flatMap((s) => s.figures), ...uncounted];

const sources = new Map<string, string>();
const cite = (s?: Src) => s && outside(s.url) && sources.set(s.label, s.url);
for (const f of [gap, ...headline, ...figures, notes.retired, notes.nextSurvey]) sources.set(f.source, f.url);
for (const o of others) for (const c of [o.reach, o.cost, o.ages, o.more, o.build, o.circuits, o.code]) cite(c.src);
for (const r of research) cite(r.src);
[guidance.src, market, manual.about, manual.advice].forEach(cite);
const widest = Math.max(gap.first.fill, gap.second.fill);

/* The drawing. Its still form is the linkage a third of the way round, with the path its
   fingertip draws; the script moves the same parts. */
const still = pose(2.1, SHAPES[0]);
const pt = (q: number[]) => q.map((v) => v.toFixed(1)).join(',');
---
<Base title="The Problem" description="Few students build anything in class, and the kits schools can buy have students follow a manual. With a source for every number.">
  <PageHeader
    title="Robotics currently isn’t hands-on for everyone."
    lede="Popular robotics kits for young students can be extremely costly, creating a high barrier for entry for schools that want to invest in engineering programs. Furthermore, many existing robotics kits are uninspired, having students follow a manual."
  >
    {/* The poster's stat panel: two numbers side by side, each with its label in capitals and
        a bar. The longer bar is full width and the shorter one is in proportion to it. */}
    <div slot="aside" class="w-full max-w-md lg:w-[26rem]" data-reveal data-count>
      <p class="stat-caption">{gap.caption}</p>
      <div class="mt-5 grid grid-cols-2 gap-x-8">
        {[gap.first, gap.second].map((g, i) => (
          <div class="grid grid-rows-subgrid row-span-3">
            <p class:list={['stat-number', i === 1 && 'stat-number-plain']}>{g.value}</p>
            <p class="stat-label-caps mt-3" title={g.label}>{g.short}</p>
            <div class="stat-bar" aria-hidden="true"><span style={`--stat-fill:${(g.fill / widest) * 100}%`}></span></div>
          </div>
        ))}
      </div>
      <p class="stat-source pt-6!">{gap.detail} <a href={gap.url} target="_blank" rel="noopener">{gap.source}</a>, {gap.year}</p>
    </div>
  </PageHeader>

  <section class="section">
    <SectionLabel>In most classrooms</SectionLabel>
    <p class="statement">Engineering is rare in class, few teachers were taught it, and a kit for four students costs over $500.</p>
    <div class="stat-group mt-8" data-count>
      {headline.map((f) => <Stat figure={f} variant="panel" />)}
    </div>
    <p class="meta measure mt-4">The class and teacher figures are from the 2018 NSSME+, a national survey of 1,273 schools and 7,600 teachers and the most recent of its kind.</p>
  </section>

  <section class="section">
    <SectionLabel>What schools can buy today</SectionLabel>
    <div class="split">
      <div>
        <p class="statement">Can you rebuild a LEGO set without the booklet?</p>
        <p class="lede mt-5">A booklet gets you to a finished model but does not say why it works, so the next model needs another booklet. {number[stepped]} of the {number[others.length].toLowerCase()} options below hand the student a manual in the same way. The trouble is not the steps: it is steps with no reasons.</p>
      </div>

      {/* The drawing: follow the steps on the left, change the linkage on the right. */}
      <div class="duo" data-duo>
        <figure class="duo-panel">
          <svg viewBox="0 0 280 190" role="img" aria-label="A robot assembled in five numbered steps. It is the same robot every time.">
            <g class="duo-ticks">
              {[1, 2, 3, 4, 5].map((n) => (
                <g data-tick={n} transform={`translate(${22 + (n - 1) * 34} 22)`}>
                  <circle r="13" />
                  <text y="6" text-anchor="middle">{n}</text>
                </g>
              ))}
            </g>
            <g class="duo-robot">
              <rect data-part="1" x="80" y="118" width="130" height="16" />
              <g data-part="2"><circle cx="104" cy="146" r="14" /><circle cx="186" cy="146" r="14" /></g>
              <rect data-part="3" x="94" y="66" width="14" height="52" />
              <rect data-part="4" x="94" y="60" width="92" height="12" />
              <g data-part="5"><rect x="186" y="50" width="26" height="8" /><rect x="186" y="74" width="26" height="8" /><rect x="180" y="50" width="8" height="32" /></g>
            </g>
          </svg>
          <figcaption><strong>Follow the steps.</strong> The same robot every time.</figcaption>
        </figure>
        <figure class="duo-panel">
          <svg viewBox="0 0 280 190" role="img" aria-label="A four-bar linkage with a fingertip. When the length of a bar changes, the path of the fingertip changes.">
            <polyline class="duo-trace" data-trace points={trace(SHAPES[0])} />
            <line class="duo-frame" x1={LEFT[0]} y1={LEFT[1]} x2={RIGHT[0]} y2={RIGHT[1]} />
            <polyline class="duo-rod" data-rod points={`${pt(still.b)} ${pt(still.c)} ${pt(still.tip)}`} />
            <line class="duo-crank" data-crank x1={LEFT[0]} y1={LEFT[1]} x2={still.b[0].toFixed(1)} y2={still.b[1].toFixed(1)} />
            <line class="duo-rocker" data-rocker x1={RIGHT[0]} y1={RIGHT[1]} x2={still.c[0].toFixed(1)} y2={still.c[1].toFixed(1)} />
            <circle class="duo-fixed" cx={LEFT[0]} cy={LEFT[1]} r="6" /><circle class="duo-fixed" cx={RIGHT[0]} cy={RIGHT[1]} r="6" />
            <circle class="duo-pin" data-pin-b cx={still.b[0].toFixed(1)} cy={still.b[1].toFixed(1)} r="4" />
            <circle class="duo-pin" data-pin-c cx={still.c[0].toFixed(1)} cy={still.c[1].toFixed(1)} r="4" />
            <circle class="duo-tip" data-tip cx={still.tip[0].toFixed(1)} cy={still.tip[1].toFixed(1)} r="6" />
          </svg>
          <figcaption><strong>Change one bar.</strong> A different motion every time. <a class="link" href={demo('student', '/dashboard/student/simulator/')}>Try it in the simulator</a>.</figcaption>
        </figure>
      </div>
    </div>

    {/* The comparison: four plain columns, ours first, one link a row. The ratings that used
        to sit beside these are in the "How we compare" window. */}
    <h3 id="compare" class="mt-14 text-lead">HelpingHand and {number[others.length].toLowerCase()} widely used options</h3>
    <div class="cmp mt-5" data-cmp>
      <table class="result-table cmp-table">
        <colgroup><col class="cmp-col-option" /><col class="cmp-col-cost" /><col class="cmp-col-ages" /><col /></colgroup>
        <thead>
          <tr>
            <th scope="col">Option</th>
            <th scope="col">Cost</th>
            <th scope="col">Ages</th>
            <th scope="col">How it gets built</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((o) => {
            const mine = o.ours && 'result';
            return (
              <tr class:list={['cmp-row', o.ours && 'cmp-ours']}>
                <th scope="row" class:list={[mine]}>
                  <span class="cmp-lead">{called(o)}</span>
                  <span class="cmp-sub">{o.ours
                    ? <>{o.reach.text}. {o.cost.src && <a class="link" {...to(o.cost.src)}>Our cost table</a>}</>
                    : o.cost.src ? <a class="link" {...to(o.cost.src)}>{o.name}</a> : o.name}</span>
                </th>
                {([['cost', 'Cost'], ['ages', 'Ages']] as const).map(([k, label]) => (
                  <td data-label={label} class:list={[mine]}>
                    {o[k].tbc
                      ? <p class="cmp-tbc">To be confirmed</p>
                      : <><p class="cmp-lead">{o[k].text}</p>{o[k].detail && <p class="cmp-sub">{o[k].detail}</p>}</>}
                  </td>
                ))}
                <td data-label="How it gets built" class:list={[mine]}>
                  <p class="cmp-lead">{o.build.tag}</p>
                  <p class="cmp-sub">{o.build.text}</p>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="cmp-foot mt-5">
      <a class="btn btn-secondary" href="#how-we-compare" data-method-open>How we compare</a>
      <p class="meta measure">Read on each maker’s own pages on 24 Nov 2026, one of them linked in each row.</p>
    </div>
  </section>

  {/* What backs the page, for the reader who wants it: three rows that open. A link to
      #all-figures, #research or #sources opens its row (the script below). */}
  <section class="section more-list">
    <details class="more" id="all-figures">
      <summary><span class="more-title">All the figures</span><span class="meta">{figures.length} more, each with its source and its year.</span></summary>
      {sections.map((s, i) => (
        <div class:list={[i > 0 && 'mt-12']}>
          <SectionLabel as="h3">{s.label}</SectionLabel>
          <p class="statement">{s.title}</p>
          <p class="lede mt-3">{s.intro}</p>
          <div class="figure-list mt-6">
            {s.figures.map((f) => <Stat figure={f} />)}
          </div>
        </div>
      ))}
      <div class="mt-12">
        <SectionLabel as="h3">What nobody counts</SectionLabel>
        <p class="statement">How many schools teach robotics specifically? Nobody knows for sure.</p>
        <p class="lede mt-3">The last national count of robotics courses is more than a decade old. The school survey this page leans on is from 2018, and <a class="link" href={notes.nextSurvey.url} target="_blank" rel="noopener">the next one was announced for 2027</a>. The national test of technology and engineering skills <a class="link" href={notes.retired.url} target="_blank" rel="noopener">was retired in 2023</a>. We show each figure with its date rather than pretend a newer number exists.</p>
        <div class="figure-list mt-6">{uncounted.map((f) => <Stat figure={f} />)}</div>
      </div>
    </details>

    <details class="more" id="research">
      <summary><span class="more-title">The research, and VEX’s own manual</span><span class="meta">Three papers on building from steps, the other side, and the {manual.pages}-page manual.</span></summary>
      <div class="split">
        <div>
          <h3 class="statement">What a competition kit starts with</h3>
          <p class="measure mt-5">This season’s starter robot for the VEX V5 competition is called Flex, and it is built from the V5 Competition Starter Kit. Its manual is <strong>{manual.pages} pages</strong>, one assembly picture to a page.</p>
          <p class="measure mt-3">VEX’s own guide recommends “to start with a set of instructions” before “assembling your first custom-designed robot”, and adds that “the next adventure will be designing your own robot”. The manual gets a team to a working robot. Designing the next one is left for later.</p>
          <p class="meta measure mt-4">Sources: <a class="link" href={manual.about.url} target="_blank" rel="noopener">{manual.about.label}</a>; <a class="link" href={manual.advice.url} target="_blank" rel="noopener">{manual.advice.label}</a>. Checked 24 Nov 2026.</p>
        </div>
        <div class="manual" data-manual={manual.pdf}>
          <div class="manual-frame" data-manual-frame hidden></div>
          <div class="manual-bar">
            <button type="button" class="btn btn-primary manual-open" data-manual-open hidden>Open the manual here</button>
            <a class="btn btn-secondary" href={manual.pdf} target="_blank" rel="noopener">Open it on VEX’s site</a>
          </div>
          <p class="meta measure mt-3">{manual.pages} pages, 18 MB, loaded from VEX’s own server when you ask for it. Build instructions © VEX Robotics, Inc. We show them as VEX publishes them and keep no copy.</p>
        </div>
      </div>

      <div class="split mt-14">
        <h3 class="statement">What researchers say about building from steps</h3>
        <ul class="quotes">
          {research.map((r) => (
            <li>
              <p class="measure">“{r.quote}”</p>
              <p class="meta measure mt-2"><a class="link" href={r.src.url} target="_blank" rel="noopener">{r.who}</a>. {r.note}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="split mt-14">
        <h3 class="statement">The other side</h3>
        <div>
          <p class="measure">“{guidance.quote}”</p>
          <p class="meta measure mt-2"><a class="link" href={guidance.src.url} target="_blank" rel="noopener">Kirschner, Sweller and Clark, 2006</a>.</p>
          <p class="measure mt-4">Nobody has counted how many kits are built from steps, and no study shows that steps harm learning. What the research supports is narrower: steps alone do not teach why.</p>
        </div>
      </div>
    </details>

    <details class="more" id="sources">
      <summary><span class="more-title">Sources</span><span class="meta">{sources.size} documents and pages, checked in October and November 2026.</span></summary>
      <p class="measure">Vendor prices change, so each one carries the year it was read.</p>
      <ol class="sources mt-6">
        {[...sources.entries()].map(([name, url]) => (
          <li><a class="link" href={url} target="_blank" rel="noopener">{name}</a></li>
        ))}
      </ol>
    </details>
  </section>

  {/* "How we compare": the ratings that left the page, and the rules behind every cell, in a
      window that opens over the page. With scripting off it is an ordinary section here,
      above the band that closes the page. */}
  <dialog class="method" id="how-we-compare" aria-labelledby="method-title">
    <div class="method-head">
      <h2 id="method-title" class="text-lead">How we compare</h2>
      <button type="button" class="btn btn-secondary method-close" data-method-close>Close</button>
    </div>
    <div class="method-body">
      {/* The first thing in the window (Lingbo, 2026-11-25): the mechanics count puts one
          lesson beside finished curricula, and a reader should know that before the numbers. */}
      <p class="method-frame"><strong>HelpingHand has one lesson so far. The others are finished curricula.</strong> The counts below are what Lesson 1 and the simulator teach today. What is planned and not taught yet is marked * (WIP).</p>
      <p>Checked on 24 Nov 2026. Say so if a cell is wrong: <a class="link" href={p('/team/')}>the team’s addresses are on the Team page</a>.</p>

      <h3>Mechanics, circuits and code</h3>
      <p>What each option teaches, read from its maker’s own lessons and help pages.</p>
      <table class="result-table cmp-table cmp-over mt-4">
        <colgroup><col style="width:20%" /><col style="width:19.5rem" /><col /><col /></colgroup>
        <thead>
          <tr>
            <th scope="col">Option</th>
            <th scope="col">Mechanics</th>
            <th scope="col">Circuits</th>
            <th scope="col">Code</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((o) => {
            const cells = strip(o.key), t = totals(o.key);
            return (
              <tr>
                <th scope="row" class:list={[o.ours && 'result']}>{called(o)}<span class="cmp-sub">{o.ours ? o.maker : o.name}</span></th>
                <td data-label="Mechanics">
                  <div class="strip" role="img" aria-label={`Mechanics: ${t.explained} of ${CONCEPT_COUNT} concepts explained, ${t.made} made by the student${t.wip ? `, ${t.wip} planned` : ''}`}>
                    {cells.map((c) => (
                      <span class:list={['strip-cell', c.made > 0 && 'is-made', c.wip > 0 && 'is-wip']} style={`--share:${c.explained / c.of}`} title={`${c.name}: ${c.explained} of ${c.of} explained${c.made ? `, ${c.made} made by the student` : ''}${c.wip ? `, ${c.wip} planned * (WIP)` : ''}`}>
                        <span>{c.explained || (c.wip ? '' : '0')}{c.wip > 0 && '*'}</span>
                      </span>
                    ))}
                  </div>
                  <p class="cmp-sub">{t.explained} of {CONCEPT_COUNT} explained, {t.made} made by the student{t.wip > 0 && <>, {t.wip} more * (WIP)</>}{o.mechanicsNote && <>. {o.mechanicsNote}</>}</p>
                </td>
                {([['circuits', 'Circuits'], ['code', 'Code']] as const).map(([k, label]) => (
                  <td data-label={label}><p>{o[k].src ? <a class="link" {...to(o[k].src!)}>{o[k].text}</a> : o[k].text}</p></td>
                ))}
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="cmp-key mt-4">
        <p class="meta"><span class="strip-cell" style="--share:0.6"><span>3</span></span> <span>One square for each group of mechanics concepts, in this order: {GROUPS.map((g) => g.short.toLowerCase()).join('; ')}. The number is how many of that group’s concepts an official lesson explains.</span></p>
        <p class="meta"><span class="strip-cell is-made" style="--share:0.6"><span>3</span></span> <span>The student makes at least one of them: draws or designs it, not only assembles it.</span></p>
        <p class="meta"><span class="strip-cell is-wip" style="--share:0"><span>*</span></span> <span>Planned for HelpingHand, with no lesson on this site yet: * (WIP).</span></p>
      </div>

      <h3>How widely each is used, and the cost to go further</h3>
      <table class="result-table cmp-table mt-4">
        <colgroup><col style="width:20%" /><col /><col /></colgroup>
        <thead>
          <tr>
            <th scope="col">Option</th>
            <th scope="col">How widely it is used</th>
            <th scope="col">Cost to go further</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((o) => (
            <tr>
              <th scope="row" class:list={[o.ours && 'result']}>{called(o)}<span class="cmp-sub">{o.ours ? o.maker : o.name}</span></th>
              {([['reach', 'How widely it is used'], ['more', 'Cost to go further']] as const).map(([k, label]) => (
                <td data-label={label}>
                  <p class:list={[o[k].tbc && 'cmp-tbc']}>{o[k].src ? <a class="link" {...to(o[k].src!)}>{o[k].text}</a> : o[k].text}</p>
                  {o[k].detail && <p class="cmp-sub">{o[k].detail}</p>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>

      <h3>The rules</h3>
      <ul class="method-rules">
        <li><strong>Other makers’ products</strong> are described only from the maker’s or organizer’s own pages. In this window each cell links to the page it was read on; the table on the page keeps one link a row. A blank means we found nothing there, not that nothing exists.</li>
        <li><strong>“To be confirmed”</strong> marks what nobody on the team has read at its source yet. VEX’s store blocks our price check, and its ages are not on the pages we could open.</li>
        <li><strong>Cost</strong> is the price on the maker’s page on the day we checked, with the number of students the maker says one kit serves. <strong>Cost to go further</strong> is the maker’s cheapest official add-on that gives the student something new to build.</li>
        <li><strong>How it gets built</strong> is what the maker ships: step-by-step instructions for a set robot, nothing to build, or the student’s own design.</li>
        <li><strong>HelpingHand is rated by the same rules</strong>, from this site as it stands. Anything no lesson here teaches today is marked * (WIP), even where the hand already has the part.</li>
        <li><strong>The four makers</strong> are the ones <a class="link" href={market.url} target="_blank" rel="noopener">a market-research firm’s estimate</a> names as the largest in schools.</li>
      </ul>

      <h3>What each one does well</h3>
      <ul class="method-rules">
        {others.map((o) => <li><strong>{o.maker}, {o.name}.</strong> {o.good}</li>)}
      </ul>

      <h3>Mechanics: {CONCEPT_COUNT} concepts from seven public lists</h3>
      <p>We did not write the list of what there is to learn. It is merged from seven lists that robotics teams and teachers already use. The number after a concept says which lists name it.</p>
      <ol class="method-lists">
        {LISTS.map((l) => <li><a class="link" href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
      </ol>
      <p>A concept can earn three marks for each option:</p>
      <ul class="method-marks">
        <li><span class="mark mark-E">E</span> <span><strong>Explained.</strong> An official lesson or help page teaches it by name.</span></li>
        <li><span class="mark mark-S">S</span> <span><strong>Built from steps.</strong> The official build instructions for a set robot have the student assemble it.</span></li>
        <li><span class="mark mark-M">M</span> <span><strong>Made by the student.</strong> Official material asks the student to draw or design their own.</span></li>
        <li><span class="mark mark-W">*</span> <span><strong>Planned (WIP).</strong> HelpingHand only: the hand has it or a lesson is planned, and nothing on this site teaches it yet.</span></li>
      </ul>
      <p>Three of the seven lists are written around VEX and FIRST parts, so the list leans toward competition robots. A hand has no drivetrain and no launcher, and about twenty of the concepts will never apply to it.</p>
      <p>We marked the others generously. A short mention still earns “explained”, and for VEX and FIRST, guidance on designing a custom robot counts as “made by the student”. Some of FIRST’s marks rest on its 2021–22 Class Pack lesson guides. LEGO’s rest on the one lesson of its 30 that opens without signing in. Sphero’s lessons did not open for our tools, so its column is not checked.</p>
      <p>Of the {CHECKED.quoted} marks that quote a page, {CHECKED.found} were found on their pages on 24 Nov 2026. The other {CHECKED.quoted - CHECKED.found} rest on VEX STEM Lab pages that do not open for our checker. {CHECKED.pictures} more describe a picture in a set of build instructions.</p>

      <div class="table-scroll mt-6">
        <table class="result-table result-table-compact method-grid">
          <thead>
            <tr>
              <th scope="col">Concept</th>
              {rows.map((o) => <th scope="col">{called(o)}</th>)}
            </tr>
          </thead>
          <tbody>
            {GROUPS.map((g) => (
              <>
                <tr class="method-group"><th scope="colgroup" colspan={rows.length + 1}>{g.name}</th></tr>
                {g.concepts.map((c) => (
                  <tr>
                    <th scope="row">{c.name} <span class="method-lists-of" title={`Named by lists ${c.lists.join(', ')}`}>{c.lists.join(' ')}</span></th>
                    {rows.map((o) => (
                      <td>
                        {(RATINGS[o.key][c.n] ?? []).map((r) => r.url
                          ? <a class:list={['mark', `mark-${r.m}`]} href={href(r.url)} target={outside(r.url) ? '_blank' : undefined} rel="noopener" title={`${MARKS[r.m].word}${r.q ? `: “${r.q}”` : r.seen ? `. ${r.seen}` : ''}`}>{MARKS[r.m].letter}<span class="sr-only"> {MARKS[r.m].word}</span></a>
                          : <span class:list={['mark', `mark-${r.m}`]} title={MARKS[r.m].word}>{MARKS[r.m].letter}<span class="sr-only"> {MARKS[r.m].word}</span></span>)}
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta mt-3">Each letter links to the page it rests on. Hover over one to read that page’s words.</p>
    </div>
  </dialog>

  <section class="band band-close">
    <div class="wrap">
      <SectionLabel>What HelpingHand changes</SectionLabel>
      <div class="split">
        <div>
          <p class="statement text-white">Every student deserves the chance to build a foundation in robotics.</p>
          <p class="measure mt-5 text-(--on-navy-soft)">We are not trying to replace competition robotics: we are going after what comes before it, the kits and the curriculum students start with.</p>
          {/* The team's goal, in the poster's words (docs/README.md, "Words from the poster"). */}
          <p class="measure mt-4 text-(--on-navy-soft)">Our goal is to <strong class="text-white">transform</strong> how robotics is taught in the classroom, fostering the highest level of creativity while prioritizing accessibility.</p>
        </div>
        <ol class="numbered on-navy">
          <li>Provide a <strong>scalable</strong> framework that evolves alongside the learner.</li>
          {/* The poster's second objective names "(FIRST, VEX, LEGO, etc.)". FIRST is a competition,
              and the sentence beside this list says we do not replace those: Lingbo took it out
              of the list here on 2026-11-25. */}
          <li>Offer an <strong>affordable</strong> and <strong>accessible</strong> alternative to traditional robotics kits (VEX, LEGO, etc.)</li>
        </ol>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={p('/kit/')}>See the kit</a>
        <a class="btn btn-secondary" href={p('/lessons/beginner/')}>Browse the lessons</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
