  .strip-cell.is-wip { border-style: dashed; border-color: var(--color-navy); }
  .cmp-ours .strip-cell:not(.is-made) { background-color: var(--color-white); }

  /* ---------- "All the figures" ---------- */
  .more { border-top: 2px solid var(--color-navy); border-bottom: 1px solid var(--color-edge); }
