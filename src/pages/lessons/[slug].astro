---
// STUB – Person B replaces the markup below. Person A owns this frontmatter.
// Do not set prerender = true. Teacher-only blocks are removed per request.
export const prerender = false;

import LessonLayout from '../../layouts/LessonLayout.astro';
import { getLesson, getLessons } from '../../lib/lessons';

const lesson = await getLesson(Astro.params.slug!, Astro.locals.user!);
if (!lesson) return Astro.rewrite('/404');

const openable = (await getLessons(Astro.locals.user!)).filter((item) => item.status !== 'coming-soon');
const index = openable.findIndex((item) => item.slug === lesson.summary.slug);
const previous = index > 0 ? openable[index - 1] : null;
const nextLesson = index !== -1 && index < openable.length - 1 ? openable[index + 1] : null;
const { Content } = lesson;
---

<LessonLayout lesson={lesson} previous={previous} next={nextLesson}>
  <Content />
</LessonLayout>
