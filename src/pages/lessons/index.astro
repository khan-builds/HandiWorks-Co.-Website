---
// STUB – Person B replaces the markup below. Person A owns this frontmatter.
// Do not set prerender = true. This page depends on the logged-in user.
export const prerender = false;

import LessonCard from '../../components/LessonCard.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getLessons } from '../../lib/lessons';

const lessons = await getLessons(Astro.locals.user!);
const requested = Astro.url.searchParams.get('level');
const level =
  requested === 'beginner' || requested === 'intermediate' || requested === 'advanced'
    ? requested
    : null;
const visible = level ? lessons.filter((lesson) => lesson.level === level) : lessons;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lessons · HelpingHand</title>
  </head>
  <body>
    <SiteHeader user={Astro.locals.user} />
    <main id="main">
      <h1>Lessons</h1>
      <p>Start with Lesson 1. Each lesson builds on the one before.</p>
      <nav aria-label="Filter by level">
        <a href="/lessons">All</a>
        <a href="/lessons?level=beginner">Beginner</a>
        <a href="/lessons?level=intermediate">Intermediate</a>
        <a href="/lessons?level=advanced">Advanced</a>
      </nav>
      {
        visible.length === 0 ? (
          <p>No lessons at this level yet.</p>
        ) : (
          <ul>
            {visible.map((lesson) => (
              <li>
                <LessonCard lesson={lesson} />
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
