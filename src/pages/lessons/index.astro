---
export const prerender = false;

import Base from '../../layouts/BaseLayout.astro';
import { getLessons } from '../../lib/lessons';

const requested = Astro.url.searchParams.get('level') || 'all';
const level =
  requested === 'beginner' || requested === 'intermediate' || requested === 'advanced' ? requested : 'all';
const lessons = (await getLessons(Astro.locals.user!)).filter(
  (lesson) => level === 'all' || lesson.level === level,
);
---

<Base title="Lessons">
  <p class="eyebrow">Your robotics journey</p>
  <h1>Lessons</h1>
  <p>Start with Lesson 1. Each lesson builds on the one before.</p>
  <nav class="filters" aria-label="Filter by level">
    {
      (['all', 'beginner', 'intermediate', 'advanced'] as const).map((item) => (
        <a href={item === 'all' ? '/lessons' : `?level=${item}`} aria-current={level === item ? 'page' : undefined}>
          {item[0].toUpperCase() + item.slice(1)}
        </a>
      ))
    }
  </nav>
  <div class="grid">
    {
      lessons.map((lesson) =>
        lesson.status === 'coming-soon' ? (
          <article class="card disabled" aria-disabled="true">
            <div class="num">0{lesson.lessonNumber} <span aria-hidden="true">◇</span></div>
            <p class="eyebrow">Lesson {lesson.lessonNumber}</p>
            <h2>{lesson.title}</h2>
            <span class="badge">{lesson.level}</span> <span>{lesson.durationMinutes} min</span>
            <p>{lesson.summary}</p>
            <strong>Coming soon</strong>
          </article>
        ) : (
          <a class:list={['card', lesson.status === 'draft' && 'draft']} href={`/lessons/${lesson.slug}`}>
            <div class="num">0{lesson.lessonNumber} <span aria-hidden="true">↗</span></div>
            <p class="eyebrow">Lesson {lesson.lessonNumber}</p>
            <h2>{lesson.title}</h2>
            <span class="badge">{lesson.level}</span> <span>{lesson.durationMinutes} min</span>
            <p>{lesson.summary}</p>
            {lesson.status === 'draft' ? <strong>Draft</strong> : <strong>Open lesson →</strong>}
          </a>
        ),
      )
    }
  </div>
  {!lessons.length && <p>No lessons at this level yet.</p>}
</Base>
