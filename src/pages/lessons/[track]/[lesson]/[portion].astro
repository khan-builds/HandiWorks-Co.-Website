---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../../layouts/BaseLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import SectionLabel from '../../../../components/SectionLabel.astro';
import Arrow from '../../../../components/Arrow.astro';
import ModelViewer from '../../../../components/ModelViewer.astro';
import MaterialsList from '../../../../components/MaterialsList.astro';
import { p } from '../../../../lib/url';
import { PORTIONS, TRACKS, splitLessonId } from '../../../../lib/lessons';

export async function getStaticPaths() {
  const portions = await getCollection('portions');
  return portions.map((entry) => {
    const [track, lesson, portion] = entry.id.split('/');
    return { params: { track, lesson, portion }, props: { entry } };
  });
}
const { entry } = Astro.props;
const [trackId, slug] = entry.id.split('/');
const { track } = splitLessonId(`${trackId}/${slug}`);
const lesson = (await getEntry('lessons', `${track}/${slug}`))!;
const siblings = await getCollection('portions', (e) => e.id.startsWith(`${track}/${slug}/`));
const meta = PORTIONS.find((x) => x.key === entry.data.portion)!;
const order = PORTIONS.map((x) => x.key);
const existing = order.filter((k) => siblings.some((s) => s.data.portion === k));
const i = existing.indexOf(entry.data.portion);
const prev = i > 0 ? existing[i - 1] : null;
const next = i < existing.length - 1 ? existing[i + 1] : null;
const label = (k: string) => PORTIONS.find((x) => x.key === k)!.label;
const base = `/lessons/${track}/${slug}`;
const { Content } = await render(entry);
const placeholder = entry.data.status === 'placeholder';
const slides = entry.data.slidesUrl ?? lesson.data.slidesUrl;
const docs = entry.data.docsUrl ?? lesson.data.docsUrl;
const concepts = lesson.data.concepts;
const materials = lesson.data.materials;
---
<Base title={`${entry.data.title} · ${lesson.data.title}`} description={entry.data.objectives[0]}>
  <PageHeader title={entry.data.title}>
    <nav slot="crumbs" class="crumbs" aria-label="Breadcrumb">
      <a href={p(`/lessons/${track}/`)}>{TRACKS[track].label}</a> <span class="mx-1" aria-hidden="true">/</span>
      <a href={p(`${base}/`)}>Lesson {lesson.data.number}</a> <span class="mx-1" aria-hidden="true">/</span> {meta.label}
    </nav>
    <p class="meta mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
      {!entry.data.reviewed && <span class="badge badge-draft">Draft · under team review</span>}
      <span>Lesson {lesson.data.number} · Part {meta.step} of 3 · About {entry.data.durationMinutes} minutes</span>
    </p>
    {(slides || docs) && (
      <div class="mt-7 flex flex-wrap gap-3">
        {slides && <a class="btn btn-primary" href={slides} target="_blank" rel="noopener">Open slides <Arrow dir="out" /></a>}
        {docs && <a class="btn btn-secondary" href={docs} target="_blank" rel="noopener">Lesson doc <Arrow dir="out" /></a>}
      </div>
    )}
  </PageHeader>

  <section class="section grid gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start">
    <div>
      <div class="panel">
        <SectionLabel class="section-label-sm">Objectives</SectionLabel>
        <p class="mt-4 font-semibold text-navy">You will be able to</p>
        <ul class="mt-3 grid gap-2">
          {entry.data.objectives.map((o) => (
            <li class="flex items-start gap-3"><span class="tick" aria-hidden="true"></span><span>{o}</span></li>
          ))}
        </ul>
      </div>
      {placeholder && (
        <div class="note mt-6">
          <p><strong>This part is not written yet.</strong></p>
          <p class="mt-1">The objectives above are set. The steps are being written{docs ? ' and live in the lesson doc for now' : ''}.</p>
        </div>
      )}
      <article class="prose-hh mt-10"><Content components={{ h2: SectionLabel }} /></article>

      <nav class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-navy pt-6" aria-label="Parts of this lesson">
        {prev ? <a class="btn btn-secondary" href={p(`${base}/${prev}/`)}><Arrow dir="left" /> {label(prev)}</a> : <a class="btn btn-secondary" href={p(`${base}/`)}><Arrow dir="left" /> Lesson overview</a>}
        {next ? <a class="btn btn-primary" href={p(`${base}/${next}/`)}>Next: {label(next)} <Arrow /></a> : <a class="btn btn-primary" href={p(`/lessons/${track}/`)}>Back to all lessons <Arrow /></a>}
      </nav>
    </div>

    <aside class="grid gap-10 lg:sticky lg:top-24">
      {entry.data.modelSrc && <ModelViewer src={entry.data.modelSrc} alt={`3D model for ${entry.data.title}`} label={entry.data.modelCaption} height="h-72" />}
      <div>
        <SectionLabel class="section-label-sm">In this lesson</SectionLabel>
        <ol class="mt-4 grid gap-2.5 text-[0.9375rem]">
          {PORTIONS.map((pt) => {
            const has = existing.includes(pt.key);
            const current = pt.key === entry.data.portion;
            return (
              <li class:list={['flex items-center gap-3', current ? 'font-semibold text-navy' : 'text-rule']} aria-current={current ? 'step' : undefined}>
                <span class:list={['grid h-6 w-6 shrink-0 place-items-center rounded-full border border-navy text-xs font-semibold', current ? 'bg-navy text-white' : 'text-navy']}>{pt.step}</span>
                {has ? <a class="hover:underline" href={p(`${base}/${pt.key}/`)}>{pt.label}</a> : <span>{pt.label} · coming soon</span>}
              </li>
            );
          })}
        </ol>
        <a class="link mt-4 inline-block text-[0.9375rem]" href={p(`${base}/`)}>Lesson overview</a>
      </div>
      {concepts.length > 0 && (
        <div>
          <SectionLabel class="section-label-sm">Concepts</SectionLabel>
          <ul class="mt-4 flex flex-wrap gap-2">{concepts.map((c) => <li class="bg-panel px-2.5 py-1 text-sm">{c}</li>)}</ul>
        </div>
      )}
      {materials.length > 0 && (
        <div>
          <SectionLabel class="section-label-sm">Materials</SectionLabel>
          <MaterialsList materials={materials} class="mt-4 text-[0.9375rem]" />
        </div>
      )}
    </aside>
  </section>

</Base>
