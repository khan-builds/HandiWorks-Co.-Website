---
/* Every colour, type size and building block of the theme, on one page. Not linked from the
   nav. The written version is the Theme section of docs/README.md: keep the two in step. */
import Base from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Stat from '../components/Stat.astro';
import ProcessRail from '../components/ProcessRail.astro';
import FigurePlaceholder from '../components/FigurePlaceholder.astro';
import Arrow from '../components/Arrow.astro';
import Logo from '../components/Logo.astro';
import { headline, gap } from '../data/evidence';

const colors = [
  { name: 'navy', hex: '#133476', use: 'Bands, section labels, table header rows, primary buttons, links, headings on white', dark: true },
  { name: 'white', hex: '#FFFFFF', use: 'Page background, text on navy' },
  { name: 'panel', hex: '#F5F5F5', use: 'Quiet panels and rows on the white page' },
  { name: 'edge', hex: '#ECEEF2', use: 'Hairline borders, dividers' },
  { name: 'lime', hex: '#E5FEC3', use: 'The highlight, for results only: a done cell, a total, a signed-off lesson' },
  { name: 'sky', hex: '#70D0F0', use: 'The accent, on navy only: big numbers, small strokes. Never text on white' },
  { name: 'ink', hex: '#000000', use: 'Body text', dark: true },
  { name: 'rule', hex: '#595959', use: 'The rule beside a section label, secondary text', dark: true },
];

/* The whole scale: five sizes, plus 13px for boxed labels and code. Nothing else is used. */
const type: { name: string; spec: string; cls: string; html?: string }[] = [
  { name: 'Display', spec: '--t-display · 36 to 56px · 700 · page titles, the big numbers', cls: 'page-title text-navy' },
  { name: 'Statement', spec: '--t-statement · 24 to 30px · 700 · the sentence that leads a section', cls: 'statement' },
  { name: 'Lead', spec: '--t-lead · 18 to 20px · ledes (400) and small headings (600, navy)', cls: 'text-lead font-semibold text-navy' },
  { name: 'Body', spec: '--t-body · 17px · 400 · line height 1.6 · about 70 characters to a line', cls: '' },
  { name: 'Small', spec: '--t-small · 14px · tables, buttons, the nav, captions and sources', cls: 'meta' },
  { name: 'Label', spec: '--t-label · 13px · 600 · the boxed label, status labels, code', cls: 'text-label font-semibold uppercase tracking-[0.04em] text-navy' },
];

const parts = [
  { key: 'cad', name: 'CAD', hex: '#55C3EC', from: 'the fingertip' },
  { key: 'hardware', name: 'Hardware', hex: '#B75F1E', from: 'the link' },
  { key: 'software', name: 'Software', hex: '#E4B826', from: 'the bar' },
];

const steps = [
  { title: 'CAD', body: 'Open the model and learn the parts.' },
  { title: 'Hardware', body: 'Print, assemble and test by hand.' },
  { title: 'Software', body: 'Make it move from the Arduino.' },
];
---
<Base title="Styleguide" description="Colours, type and building blocks of the HelpingHand site." noindex>
  <PageHeader title="Styleguide" lede="The poster theme as the site uses it. Every page is assembled from the blocks below.">
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a class="btn btn-primary" href="#buttons">Primary on navy</a>
      <a class="btn btn-secondary" href="#buttons">Secondary on navy</a>
      <span class="badge">Prototype</span>
    </div>
  </PageHeader>

  <section class="section">
    <SectionLabel>Colours</SectionLabel>
    <ul class="grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {colors.map((c) => (
        <li>
          <div class:list={['flex h-24 items-end border border-edge p-3 text-small font-semibold', c.dark ? 'text-white' : 'text-navy']} style={`background:${c.hex}`}>{c.hex}</div>
          <p class="mt-3 font-semibold text-navy">{c.name}</p>
          <p class="meta mt-1">{c.use}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <SectionLabel>Logo</SectionLabel>
    <p class="lede ">The HandiWorks Co. mark, traced from the poster: two white blocks and a sky link. It stands in until the logo file arrives. On navy only.</p>
    <div class="band mt-8 flex flex-wrap items-center gap-x-16 gap-y-8 p-8">
      <p class="lockup"><Logo /><span class="lockup-name">HandiWorks <small>Co.</small></span></p>
      <p class="wordmark"><Logo /><span class="wordmark-text"><span class="wordmark-name">HelpingHand</span><span class="wordmark-co">HandiWorks Co.</span></span></p>
    </div>
  </section>

  <section class="section">
    <SectionLabel>Type</SectionLabel>
    <p class="lede ">Inter, one file, served from this site. No other typeface. Three weights, as on the poster: 400 for text, 600 for labels and small headings, 700 for titles and the words that matter. Code uses the system monospace.</p>
    <div class="mt-6 border-t border-navy">
      {type.map((t) => (
        <div class="grid gap-x-8 gap-y-2 border-b border-edge py-5 md:grid-cols-[14rem_1fr] md:items-baseline">
          <p class="meta"><span class="block font-semibold text-ink">{t.name}</span>{t.spec}</p>
          <p class={t.cls} set:html={t.html ?? 'Build a robotic hand.'} />
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionLabel>Section label</SectionLabel>
    <p class="statement">The label names the section. The sentence leads it.</p>
    <p class="measure mt-5">White capitals in a small navy box, on the rule that opens a section and runs to the edge of the column. One size, everywhere. The sentence under it is the section's heading. The rule draws in as the label comes on screen.</p>
  </section>

  <section class="section">
    <SectionLabel>The two layouts</SectionLabel>
    <div class="split">
      <div>
        <p class="statement">Full width, or split.</p>
        <p class="measure mt-5">In a split the sentence and its words take the narrower left column, and the thing they are about takes the wider right one. Rules, tables and boxes all end on the same right edge; sentences keep a measure of about 70 characters.</p>
      </div>
      <ul class="rows">
        <li><p>Split</p><p>A table, a list, a model or a drawing beside the words about it.</p></li>
        <li><p>Full width</p><p>A row of columns, a wide drawing, a list of questions.</p></li>
        <li><p>Main and sidebar</p><p>Lessons and dashboards only: pages that are worked in.</p></li>
      </ul>
    </div>
    <details class="more mt-10">
      <summary><span class="more-title">A row that opens</span><span class="meta">For what most readers do not need: sources, specifications, the long form of an argument.</span></summary>
      <p class="measure">Closed until asked for. The Kit keeps its circuit and specifications in one, and The Problem its sources.</p>
    </details>
  </section>

  <section class="section">
    <SectionLabel>Lesson parts</SectionLabel>
    <div class="split">
      <div>
        <p class="statement">Each part of a lesson wears one colour of the hand.</p>
        <p class="measure mt-5">Wherever a part's number is shown, and in the strip under the title of its page. Nowhere else: the navy and the lime keep their jobs.</p>
      </div>
      <ol class="numbered">
        {parts.map((pt) => <li data-part={pt.key}><h3>{pt.name}</h3><p class="mt-1">{pt.hex}, from {pt.from}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="buttons">
    <SectionLabel>Buttons</SectionLabel>
    <div class="flex flex-wrap items-center gap-3">
      <a class="btn btn-primary" href="#buttons">Primary</a>
      <a class="btn btn-secondary" href="#buttons">Secondary</a>
      <a class="btn btn-primary" href="#buttons">With an arrow <Arrow /></a>
      <a class="btn btn-ghost" href="#buttons">Text link</a>
      <span class="btn btn-primary" aria-disabled="true">Not live</span>
    </div>
  </section>

  <section class="section">
    <SectionLabel>Status labels</SectionLabel>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <span class="badge">Prototype</span>
      <span class="badge">Demo</span>
      <span class="badge">Coming soon</span>
      <span class="badge badge-live">Live</span>
      <span class="inline-flex items-center gap-2 text-small"><span class="dot dot-done"></span>Done</span>
      <span class="inline-flex items-center gap-2 text-small"><span class="dot dot-progress"></span>In progress</span>
      <span class="inline-flex items-center gap-2 text-small"><span class="dot dot-none"></span>Not started</span>
      <span class="w-48"><span class="meter"><span style="width:62%"></span></span></span>
    </div>
  </section>

  <section class="section">
    <SectionLabel>Panel and note</SectionLabel>
    <div class="grid gap-5 md:grid-cols-3">
      <div class="panel">
        <h3 class="text-lead">Panel</h3>
        <p class="mt-2 text-smallall text-rule">A grey block for supporting text.</p>
      </div>
      <a class="panel" href="#buttons">
        <h3 class="text-lead">Panel as a link</h3>
        <p class="mt-2 text-smallall text-rule">Tints and gains a navy outline on hover.</p>
      </a>
      <aside class="lesson-aside my-0! self-start"><p class="lesson-aside-title">Tip</p><p>A note or a tip in a lesson is an outlined box.</p></aside>
    </div>
  </section>

  <section class="section">
    <SectionLabel>Stat panel</SectionLabel>
    <p class="lede ">Top to bottom, as on the poster: caption, number, what it counts, a bar as long as the number, source. A bar is drawn only for a percentage.</p>
    <div class="mt-8 grid gap-5 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:items-start">
      <div class="stat-panel" data-reveal>
        <p class="stat-caption">{gap.caption}</p>
        <div class="mt-5 grid grid-cols-2 gap-x-8">
          {[gap.highPoverty, gap.lowPoverty].map((g, i) => (
            <div class="grid grid-rows-subgrid row-span-3">
              <p class:list={['stat-number', i === 1 && 'stat-number-plain']}>{g.value}</p>
              <p class="stat-label-caps mt-3">{g.short}</p>
              <div class="stat-bar" aria-hidden="true"><span style={`--stat-fill:${(g.fill / gap.lowPoverty.fill) * 100}%`}></span></div>
            </div>
          ))}
        </div>
        <p class="stat-source pt-6!"><a href={gap.url} target="_blank" rel="noopener">{gap.source}</a>, {gap.year}</p>
      </div>
      <p class="meta max-w-sm">Two numbers side by side: the one the page argues against is sky and lighter, the one it argues for is white and bold. The longer bar is full width and the shorter is in proportion.</p>
    </div>
    <div class="stat-group mt-5">
      {headline.map((f) => <Stat figure={f} variant="panel" />)}
    </div>
    <div class="figure-list mt-10">
      {headline.slice(0, 2).map((f) => <Stat figure={f} />)}
    </div>
  </section>

  <section class="section">
    <SectionLabel>Result table</SectionLabel>
    <div class="table-scroll ">
      <table class="result-table min-w-[36rem]">
        <thead><tr><th scope="col">Trial</th><th scope="col">Motor 1 ran? Direction</th><th scope="col">Motor 2 ran? Direction</th></tr></thead>
        <tbody>
          <tr><th scope="row">Motor 1: clockwise and counterclockwise</th><td class="result">Yes. Clockwise and counterclockwise</td><td class="result">No</td></tr>
          <tr><th scope="row">Both motors: clockwise and counterclockwise</th><td class="result">Yes. Clockwise and counterclockwise</td><td class="result">Yes. Clockwise and counterclockwise</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <SectionLabel>Numbered point</SectionLabel>
    <ol class="numbered max-w-2xl">
      <li>Provide a <strong>scalable</strong> framework that evolves alongside the learner.</li>
      <li>Offer an <strong>affordable</strong> and <strong>accessible</strong> alternative to traditional robotics kits.</li>
    </ol>
  </section>

  <section class="section">
    <SectionLabel>Timeline and steps</SectionLabel>
    <ol class="timeline ">
      <li class="is-now"><p class="timeline-when">Phase 1 · Now</p><div class="timeline-what"><h3>The kit</h3><p>A static curriculum.</p></div></li>
      <li><p class="timeline-when">Phase 2</p><div class="timeline-what"><h3>Accounts</h3><p>Classrooms and progress.</p></div></li>
      <li><p class="timeline-when">Phase 3</p><div class="timeline-what"><h3>Community</h3><p>Showcase and forum.</p></div></li>
      <li><p class="timeline-when">Phase 4</p><div class="timeline-what"><h3>More tracks</h3><p>New mechanisms.</p></div></li>
    </ol>
    <ProcessRail steps={steps} class="mt-14" />
  </section>

  <section class="section">
    <SectionLabel>Frames</SectionLabel>
    <div class="grid gap-8 md:grid-cols-2">
      <figure>
        <div class="frame h-56"></div>
        <figcaption class="caption">Frame: a model or an image sits here, with its caption underneath.</figcaption>
      </figure>
      <FigurePlaceholder class="my-0!" caption="An image the team has not sent yet." />
    </div>
  </section>

  <section class="band band-close">
    <div class="wrap">
      <SectionLabel>Band</SectionLabel>
      <p class="statement text-white">A full-width navy block. The page header, the footer, and at most one more per page.</p>
      <div class="columns mt-10">
        <div><h3 class="text-lead">Columns</h3><p class="mt-2 text-(--on-navy-soft)">Split by hairlines, as on the poster.</p></div>
        <div><h3 class="text-lead">Text</h3><p class="mt-2 text-(--on-navy-soft)">White, with secondary text mixed from white and navy.</p></div>
        <div><h3 class="text-lead">Buttons</h3><p class="mt-2 text-(--on-navy-soft)">Flip to white on their own.</p></div>
      </div>
    </div>
  </section>
</Base>
