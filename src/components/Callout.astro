---
interface Props {
  type: 'note' | 'tip' | 'safety' | 'teacher';
  title?: string;
}
const titles = { note: 'Note', tip: 'Tip', safety: 'Safety', teacher: 'Teacher note' };
const { type, title = titles[type] } = Astro.props;
---

<aside class:list={['callout', type]} aria-label={title}>
  {type === 'teacher' && <span class="badge">Teacher only</span>}
  <h3>{title}</h3>
  <slot />
</aside>
