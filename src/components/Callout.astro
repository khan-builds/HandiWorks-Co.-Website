---
// STUB – Person B replaces this
interface Props {
  type: 'note' | 'tip' | 'safety' | 'teacher';
  title?: string;
}
const titles = { note: 'Note', tip: 'Tip', safety: 'Safety', teacher: 'Teacher note' };
const { type, title = titles[type] } = Astro.props;
---

<aside aria-label={title} data-callout={type}>
  <p>{title}</p>
  {type === 'teacher' && <p>Teacher only</p>}
  <slot />
</aside>
