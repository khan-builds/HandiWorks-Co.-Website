---
/** Strip under the title on both dashboards: says the data is made up before anything else,
    in one sentence, and carries the way back to the other role. */
import { p } from '../lib/url';
interface Props { role: 'student' | 'teacher' }
const { role } = Astro.props;
---
<div class="border-b border-edge bg-panel">
  <p class="wrap flex flex-wrap items-center gap-x-3 gap-y-1 py-2.5 text-small">
    <span class="badge">Demo</span>
    <span>{role === 'teacher' ? 'A made-up class. There are no real accounts yet.' : 'A made-up student. Nothing here is saved.'}</span>
    <a class="link md:ml-auto" href={p('/signin/')}>Switch role</a>
  </p>
</div>
