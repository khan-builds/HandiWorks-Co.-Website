---
/** One lesson as a numbered row: number on the edge, title and summary, which of its three
    parts exist, and whether it is live. Put these in a one-column list. */
import type { CollectionEntry } from 'astro:content';
import { p } from '../lib/url';
import { PORTIONS, splitLessonId } from '../lib/lessons';

interface Props {
  lesson: CollectionEntry<'lessons'>;
  portionKeys: string[];
}
const { lesson, portionKeys } = Astro.props;
const { track, slug } = splitLessonId(lesson.id);
const live = lesson.data.status === 'published';
const href = p(`/lessons/${track}/${slug}/`);
---
<a href={href} class="lesson-row panel">
  <span class="lesson-num" aria-hidden="true">{lesson.data.number}</span>
  <div>
    <h3 class="lesson-title"><span class="sr-only">Lesson {lesson.data.number}: </span>{lesson.data.title}</h3>
    <p class="lesson-summary">{lesson.data.summary}</p>
  </div>
  <ul class="lesson-parts" aria-label="Parts written so far">
    {PORTIONS.map((pt) => {
      const ready = portionKeys.includes(pt.key);
      return (
        <li>
          <span class:list={['dot', ready ? 'dot-done' : 'dot-none']} aria-hidden="true"></span>
          {pt.label}<span class="sr-only">{ready ? ', written' : ', not written yet'}</span>
        </li>
      );
    })}
  </ul>
  {live ? <span class="badge badge-live">Live</span> : <span class="badge badge-soon">Coming soon</span>}
</a>
