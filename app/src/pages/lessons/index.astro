---
import Base from '../../layouts/BaseLayout.astro';import {getLessons} from '../../lib/lessons';const level=Astro.url.searchParams.get('level')||'all';const lessons=(await getLessons(Astro.locals.user!)).filter(e=>level==='all'||e.data.level===level);
---
<Base title="Lessons"><p class="eyebrow">Your robotics journey</p><h1>Lessons</h1><p>Start with Lesson 1. Each lesson builds on the one before.</p><nav class="filters" aria-label="Filter by level">{['all','beginner','intermediate','advanced'].map(l=><a href={'?level='+l} aria-current={level===l?'page':undefined}>{l[0].toUpperCase()+l.slice(1)}</a>)}</nav><div class="grid">{lessons.map(e=>{const Tag=e.data.status==='coming-soon'?'article':'a';return <Tag class={'card '+(e.data.status==='coming-soon'?'disabled':'')} href={Tag==='a'?'/lessons/'+e.id:undefined} aria-disabled={Tag==='article'?'true':undefined}><p class="eyebrow">Lesson {e.data.lessonNumber}</p><h2>{e.data.title}</h2><span class="badge">{e.data.level}</span> <span>{e.data.durationMinutes} min</span><p>{e.data.summary}</p>{e.data.status!=='published'&&<strong>{e.data.status==='draft'?'Draft':'Coming soon'}</strong>}</Tag>})}</div>{!lessons.length&&<p>No lessons at this level yet.</p>}</Base>