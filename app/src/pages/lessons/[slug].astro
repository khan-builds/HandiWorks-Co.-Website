---
import Base from '../../layouts/BaseLayout.astro';import {getLesson} from '../../lib/lessons';const lesson=await getLesson(Astro.params.slug!,Astro.locals.user!);if(!lesson)return new Response('Lesson not found',{status:404});const {Content,data,headings}=lesson;
---
<Base title={data.title}><a href="/lessons">← Lessons</a><p class="eyebrow">Lesson {data.lessonNumber}</p><h1>{data.title}</h1><p>{data.level} · {data.durationMinutes} min</p><div class="lesson-grid"><article class="lesson"><aside class="callout"><h2>Expected outcome</h2><p>{data.expectedOutcome}</p></aside><h2>You will be able to</h2><ul>{data.objectives.map(o=><li>{o}</li>)}</ul><h2>Materials</h2><table><thead><tr><th>Item</th><th>Quantity</th><th>Notes</th></tr></thead><tbody>{data.materials.map(m=><tr><td>{m.name}</td><td>{m.quantity}</td><td>{m.note}</td></tr>)}</tbody></table><Content/><p><a href="/lessons">← Back to lessons</a> · Lesson 2 coming soon</p></article><aside class="toc"><strong>On this page</strong>{headings.filter(h=>h.depth===2&&h.text!=='Teacher notes').map(h=><a href={'#'+h.slug}>{h.text}</a>)}</aside></div></Base>